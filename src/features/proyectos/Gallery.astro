---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface GalleryImage {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

interface Props {
  images: GalleryImage[];
  title?: string;
}

const { images, title = "Galería" } = Astro.props;
const multiple = images.length > 1;

const navClass = "absolute top-1/2 z-[2] inline-flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-border bg-background pb-1 text-[1.6rem] leading-none text-primary shadow-subtle transition-colors hover:border-accent hover:text-accent max-md:h-9 max-md:w-9 max-md:text-[1.4rem]";
const lightboxNavClass = "fixed top-1/2 z-[2] inline-flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full border-0 bg-[rgba(255,255,255,0.12)] pb-1 text-[2rem] leading-none text-[#fff] transition-colors hover:bg-[rgba(255,255,255,0.25)]";
---

{images.length > 0 && (
  <section class="mb-12 border-t border-border pt-8" data-gallery>
    <h2 class="mb-5 text-title">{title}</h2>

    <div class="flex flex-col gap-3.5">
      <div
        class="relative overflow-hidden rounded-md border border-border bg-surface"
        data-stage
        tabindex="0"
        role="group"
        aria-roledescription="carrusel"
        aria-label={title}
      >
        <button type="button" class={`${navClass} left-3 max-md:left-2`} data-prev aria-label="Imagen anterior" hidden={!multiple}>‹</button>

        <div class="overflow-hidden" data-viewport>
          <div class="flex transition-transform duration-[350ms] ease-in-out" data-track>
            {images.map((img, i) => (
              <figure
                class="m-0 w-full shrink-0"
                data-slide
                data-caption={img.caption ?? ""}
                aria-hidden={i === 0 ? "false" : "true"}
              >
                <button type="button" class="block w-full cursor-zoom-in border-0 bg-transparent p-0" data-open aria-label={`Ampliar: ${img.alt}`}>
                  <Image src={img.src} alt={img.alt} loading={i === 0 ? "eager" : "lazy"} class="block h-auto w-full" />
                </button>
              </figure>
            ))}
          </div>
        </div>

        <button type="button" class={`${navClass} right-3 max-md:right-2`} data-next aria-label="Imagen siguiente" hidden={!multiple}>›</button>

        {multiple && (
          <span class="absolute bottom-3 right-3 z-[2] rounded-full bg-[rgba(16,32,31,0.72)] px-2.5 py-1 text-meta tabular-nums text-[#fff]" data-counter aria-live="polite">1 / {images.length}</span>
        )}
      </div>

      <p class="m-0 text-ui leading-[1.55] text-secondary" data-caption-text hidden></p>

      {multiple && (
        <div class="hidden gap-2.5 overflow-x-auto pb-0.5 md:flex" data-thumbs role="tablist" aria-label="Miniaturas">
          {images.map((img, i) => (
            <button
              type="button"
              class="aspect-[16/10] w-24 shrink-0 cursor-pointer overflow-hidden rounded-sm border-2 border-border bg-surface opacity-60 transition-opacity hover:opacity-100 aria-[current=true]:border-accent aria-[current=true]:opacity-100"
              data-thumb
              data-index={i}
              role="tab"
              aria-label={`Ir a la imagen ${i + 1}`}
              aria-current={i === 0 ? "true" : "false"}
            >
              <Image src={img.src} alt="" loading="lazy" class="block h-full w-full object-cover" />
            </button>
          ))}
        </div>
      )}
    </div>

    <div class="fixed inset-0 z-[1000] flex items-center justify-center p-4 sm:p-6" data-lightbox hidden>
      <div class="absolute inset-0 cursor-zoom-out bg-[rgba(16,32,31,0.82)]" data-close></div>
      <button type="button" class="absolute right-4 top-4 z-[2] inline-flex h-10 w-10 items-center justify-center rounded-full border border-border bg-background text-[1.5rem] leading-none text-primary transition-colors hover:border-accent hover:text-accent sm:right-6 sm:top-6" data-close data-close-btn aria-label="Cerrar">×</button>
      <div class="relative z-[1] flex max-w-full flex-col items-center gap-3 max-md:w-full" role="dialog" aria-modal="true" aria-label={title}>
        <button type="button" class={`${lightboxNavClass} left-2 sm:left-5`} data-prev aria-label="Imagen anterior" hidden={!multiple}>‹</button>
        <figure
          class="m-0 flex justify-center [&_img]:h-auto [&_img]:w-auto [&_img]:max-h-[76vh] [&_img]:max-w-[92vw] [&_img]:rounded-md [&_img]:bg-background [&_img]:shadow-floating [&_figcaption]:mt-2.5 [&_figcaption]:max-w-[70ch] [&_figcaption]:text-center [&_figcaption]:text-ui [&_figcaption]:leading-[1.5] [&_figcaption]:text-[rgba(255,255,255,0.85)] sm:[&_img]:max-h-[84vh] max-md:[&_img]:max-w-full"
          data-lightbox-figure
        ></figure>
        <button type="button" class={`${lightboxNavClass} right-2 sm:right-5`} data-next aria-label="Imagen siguiente" hidden={!multiple}>›</button>
        {multiple && (
          <span class="text-ui tabular-nums text-[#fff]" data-lightbox-counter aria-live="polite"></span>
        )}
      </div>
    </div>
  </section>
)}

<style>
  [data-gallery] [hidden] {
    display: none !important;
  }
</style>

<script>
  type GalleryRoot = HTMLElement;

  function initGallery(root: GalleryRoot) {
    const track = root.querySelector<HTMLElement>('[data-track]');
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
    const counter = root.querySelector<HTMLElement>('[data-counter]');
    const lightboxCounter = root.querySelector<HTMLElement>('[data-lightbox-counter]');
    const captionEl = root.querySelector<HTMLElement>('[data-caption-text]');
    const thumbs = Array.from(root.querySelectorAll<HTMLElement>('[data-thumb]'));
    const lightbox = root.querySelector<HTMLElement>('[data-lightbox]');
    const lightboxFigure = root.querySelector<HTMLElement>('[data-lightbox-figure]');
    const viewport = root.querySelector<HTMLElement>('[data-viewport]');
    if (!track || slides.length === 0) return;
    const trackEl: HTMLElement = track;

    const count = slides.length;
    let index = 0;
    let lightboxOpen = false;

    const slideImage = (i: number) => slides[i]?.querySelector('img') ?? null;

    function updateLightbox() {
      if (!lightboxFigure) return;
      const img = slideImage(index);
      const caption = slides[index]?.dataset.caption ?? '';
      lightboxFigure.innerHTML = "";
      if (img) lightboxFigure.appendChild(img.cloneNode(true));
      if (caption) {
        const cap = document.createElement('figcaption');
        cap.textContent = caption;
        lightboxFigure.appendChild(cap);
      }
    }

    function render() {
      trackEl.style.transform = `translateX(-${index * 100}%)`;
      slides.forEach((slide, i) => slide.setAttribute('aria-hidden', i === index ? 'false' : 'true'));
      thumbs.forEach((thumb, i) => thumb.setAttribute('aria-current', i === index ? 'true' : 'false'));
      if (counter) counter.textContent = `${index + 1} / ${count}`;
      if (lightboxCounter) lightboxCounter.textContent = `${index + 1} / ${count}`;
      if (captionEl) {
        const caption = slides[index]?.dataset.caption ?? '';
        captionEl.textContent = caption;
        captionEl.hidden = !caption;
      }
      if (lightboxOpen) updateLightbox();
    }

    function go(next: number) {
      index = (next + count) % count;
      render();
    }

    root.querySelectorAll<HTMLElement>('[data-prev]').forEach(btn =>
      btn.addEventListener('click', () => go(index - 1))
    );
    root.querySelectorAll<HTMLElement>('[data-next]').forEach(btn =>
      btn.addEventListener('click', () => go(index + 1))
    );

    thumbs.forEach(thumb =>
      thumb.addEventListener('click', () => go(Number(thumb.dataset.index)))
    );

    root.querySelectorAll<HTMLElement>('[data-open]').forEach(btn =>
      btn.addEventListener('click', () => openLightbox())
    );

    function openLightbox() {
      if (!lightbox) return;
      lightboxOpen = true;
      updateLightbox();
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
      root.querySelector<HTMLElement>('[data-close-btn]')?.focus();
    }

    function closeLightbox() {
      if (!lightbox) return;
      lightboxOpen = false;
      lightbox.hidden = true;
      document.body.style.overflow = '';
      root.querySelector<HTMLElement>('[data-open]')?.focus();
    }

    lightbox?.querySelectorAll<HTMLElement>('[data-close]').forEach(el =>
      el.addEventListener('click', closeLightbox)
    );

    // Swipe / arrastre horizontal en el escenario.
    // Un tap corto debe abrir el lightbox: solo se mueve el track cuando el
    // desplazamiento supera un umbral de intención horizontal.
    const DRAG_THRESHOLD = 8;
    const SWIPE_THRESHOLD = 40;
    let startX: number | null = null;
    let startY: number | null = null;
    let delta = 0;
    let dragging = false;

    const onStart = (x: number, y: number) => {
      startX = x;
      startY = y;
      delta = 0;
      dragging = false;
      trackEl.style.transition = 'none';
    };
    const onMove = (x: number, y: number) => {
      if (startX === null || startY === null) return;
      delta = x - startX;
      const dy = y - startY;
      // Si el gesto es más vertical que horizontal, no es swipe de carrusel.
      if (!dragging && Math.abs(delta) < DRAG_THRESHOLD) return;
      if (!dragging && Math.abs(dy) > Math.abs(delta)) {
        startX = null;
        startY = null;
        trackEl.style.transition = '';
        return;
      }
      dragging = true;
      trackEl.style.transform = `translateX(calc(-${index * 100}% + ${delta}px))`;
    };
    const onEnd = () => {
      if (startX === null) return;
      trackEl.style.transition = '';
      if (dragging) {
        if (Math.abs(delta) > SWIPE_THRESHOLD) go(index + (delta < 0 ? 1 : -1));
        else render();
      }
      startX = null;
      startY = null;
      delta = 0;
      dragging = false;
    };

    viewport?.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse' && e.button !== 0) return;
      onStart(e.clientX, e.clientY);
    });
    window.addEventListener('pointermove', (e) => {
      if (startX === null) return;
      onMove(e.clientX, e.clientY);
    });
    window.addEventListener('pointerup', onEnd);
    window.addEventListener('pointercancel', onEnd);

    // Teclado: se activa cuando el foco está dentro de la galería o el lightbox está abierto.
    window.addEventListener('keydown', (e) => {
      const focusedInside = root.contains(document.activeElement);
      if (!lightboxOpen && !focusedInside) return;
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        go(index - 1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        go(index + 1);
      } else if (e.key === 'Escape' && lightboxOpen) {
        e.preventDefault();
        closeLightbox();
      }
    });

    render();
  }

  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach(initGallery);
</script>

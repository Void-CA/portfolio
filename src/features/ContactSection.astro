---
import SectionHeader from '../components/ui/SectionHeader.astro';
import Icon from '../components/ui/Icon.astro';
import { CONTACT } from '../components/SiteConfig';

interface Props {
  id?: string;
  heading?: string;
  intro?: string;
  steps?: string[];
  phrase?: string;
}

const {
  id = "contacto",
  heading = "Cuentame qué necesitas",
  intro = "Si tenés un proceso que se puede automatizar, datos dispersos que deberían hablar entre sí o una herramienta que no encaja, escribime. Te respondo con un diagnóstico honesto.",
  steps = ["Me cuentas tu caso", "Lo conversamos un momento", "Evaluamos su viabilidad", "Decidimos si encaja"],
  phrase = "No necesitás preparar una especificación técnica ni tener definida la solución.",
} = Astro.props;
---

<section id={id} class="pt-20 pb-26">
  <div class="overflow-hidden rounded-2xl border border-border bg-surface">
    <div class="grid lg:grid-cols-[minmax(0,1fr)_minmax(0,0.9fr)]">
      <div class="flex flex-col items-start gap-5 p-7 sm:p-10 lg:p-12">
        <SectionHeader title={heading} />

        <p class="max-w-[52ch] text-base leading-[1.7] text-secondary">{intro}</p>

        <ol class="mt-2 hidden w-full list-none grid-cols-2 gap-x-6 gap-y-6 sm:grid sm:grid-cols-4">
          {steps.map((step, i) => (
            <li class="group relative flex flex-col gap-2.5">
              <span class="flex h-8 w-8 items-center justify-center rounded-full border border-border bg-background font-mono text-meta font-semibold text-accent transition-colors group-hover:border-accent group-hover:bg-accent-tint">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class="text-base leading-[1.4] text-primary">{step}</span>
              {i < steps.length - 1 && (
                <span class="pointer-events-none absolute left-10 top-4 hidden h-px w-[calc(100%-2.5rem)] bg-border sm:block" aria-hidden="true"></span>
              )}
            </li>
          ))}
        </ol>

        <a href={`mailto:${CONTACT.email}`} class="btn btn-primary mt-1 w-full justify-center shadow-subtle sm:w-auto">
          <Icon name="mail" class="btn-icon" />Escribime
        </a>

        <p class="text-ui leading-[1.6] text-muted">{phrase}</p>
      </div>

      <aside class="flex flex-col justify-center gap-6 border-t border-border bg-background/50 p-7 sm:p-10 lg:border-l lg:border-t-0 lg:p-12">
        <div class="hidden flex-col gap-1.5 lg:flex">
          <span class="text-micro font-bold uppercase tracking-[0.08em] text-accent">Cómo se dimensiona</span>
          <p class="text-ui leading-[1.65] text-secondary">
            Los proyectos se cotizan según alcance y complejidad. Cuando el problema
            todavía no está definido, podemos empezar por una etapa de diagnóstico y
            definición antes de comprometer el desarrollo completo.
          </p>
        </div>

        <div class="hidden flex-col gap-1.5 border-t border-border pt-5 lg:flex">
          <span class="text-micro font-bold uppercase tracking-[0.08em] text-accent">Entrega y continuidad</span>
          <p class="text-ui leading-[1.65] text-secondary">
            La entrega incluye documentación y el conocimiento necesario para operar
            el sistema. Después podemos acordar soporte o nuevas fases según evolución.
          </p>
        </div>

        <details class="group border-t border-border pt-5 lg:hidden">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-2 text-ui font-semibold text-accent [&::-webkit-details-marker]:hidden">
            Cómo se cotiza y se entrega
            <span class="font-normal transition-transform group-open:rotate-45">+</span>
          </summary>
          <div class="mt-4 flex flex-col gap-4">
            <p class="text-ui leading-[1.65] text-secondary">
              Los proyectos se cotizan según alcance y complejidad. Si el problema
              todavía no está definido, empezamos por una etapa de diagnóstico y
              definición antes de comprometer el desarrollo completo.
            </p>
            <p class="text-ui leading-[1.65] text-secondary">
              La entrega incluye documentación y el conocimiento para operar el sistema.
              Después podemos acordar soporte o nuevas fases según evolución.
            </p>
          </div>
        </details>

        <div class="flex flex-col gap-1.5 border-t border-border pt-5">
          <span class="text-micro font-bold uppercase tracking-[0.08em] text-accent">Otros canales</span>
          <div class="mt-1 flex flex-wrap gap-3">
            <a href={CONTACT.linkedin} class="btn btn-secondary flex-1 justify-center sm:flex-none" target="_blank" rel="noopener">
              <Icon name="linkedin" class="btn-icon" />LinkedIn
            </a>
            <a href={CONTACT.github} class="btn btn-secondary flex-1 justify-center sm:flex-none" target="_blank" rel="noopener">
              <Icon name="github" class="btn-icon" />GitHub
            </a>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>

---
import SectionHeader from '../components/ui/SectionHeader.astro';
import Icon from '../components/ui/Icon.astro';
import { CONTACT } from '../components/SiteConfig';

interface Props {
  id?: string;
  heading?: string;
  intro?: string;
  steps?: string[];
  phrase?: string;
}

const {
  id = "contacto",
  heading = "Contame qué necesitás",
  intro = "Si tenés un proceso que se puede automatizar, datos dispersos que deberían hablar entre sí o una herramienta que no encaja, escribime. Te respondo con un diagnóstico honesto.",
  steps = ["Me escribís", "Entiendo el problema", "Primera conversación", "Definimos si avanzar"],
  phrase = "No necesitás preparar una especificación técnica ni tener definida la solución.",
} = Astro.props;
---

<section id={id} class="pt-20 pb-26">
  <div class="overflow-hidden rounded-2xl border border-border bg-surface">
    <div class="grid lg:grid-cols-[minmax(0,1fr)_minmax(0,0.9fr)]">
      <div class="flex flex-col items-start gap-5 p-7 sm:p-10 lg:p-12">
        <SectionHeader title={heading} />

        <p class="max-w-[52ch] text-base leading-[1.7] text-secondary">{intro}</p>

        <ol class="flex list-none flex-wrap items-center gap-x-2 gap-y-2 font-mono text-meta text-secondary">
          {steps.map((step, i) => (
            <li class="inline-flex items-center gap-2">
              <span class="rounded-md border border-border bg-background px-2.5 py-1 text-primary">{step}</span>
              {i < steps.length - 1 && <span class="select-none text-accent">→</span>}
            </li>
          ))}
        </ol>

        <a href={`mailto:${CONTACT.email}`} class="btn btn-primary mt-1 w-full justify-center shadow-subtle sm:w-auto">
          <Icon name="mail" class="btn-icon" />Escribime
        </a>

        <p class="text-ui leading-[1.6] text-muted">{phrase}</p>
      </div>

      <aside class="flex flex-col justify-center gap-6 border-t border-border bg-background/50 p-7 sm:p-10 lg:border-l lg:border-t-0 lg:p-12">
        <div class="flex flex-col gap-1.5">
          <span class="text-micro font-bold uppercase tracking-[0.08em] text-accent">Cómo se dimensiona</span>
          <p class="text-ui leading-[1.65] text-secondary">
            Los proyectos se cotizan según alcance y complejidad. Cuando el problema
            todavía no está definido, podemos empezar por una etapa de diagnóstico y
            definición antes de comprometer el desarrollo completo.
          </p>
        </div>

        <div class="flex flex-col gap-1.5 border-t border-border pt-5">
          <span class="text-micro font-bold uppercase tracking-[0.08em] text-accent">Entrega y continuidad</span>
          <p class="text-ui leading-[1.65] text-secondary">
            La entrega incluye documentación y el conocimiento necesario para operar
            el sistema. Después podemos acordar soporte o nuevas fases según evolución.
          </p>
        </div>

        <div class="flex flex-col gap-1.5 border-t border-border pt-5">
          <span class="text-micro font-bold uppercase tracking-[0.08em] text-accent">Otros canales</span>
          <div class="mt-1 flex flex-wrap gap-3">
            <a href={CONTACT.linkedin} class="btn btn-secondary justify-center" target="_blank" rel="noopener">
              <Icon name="linkedin" class="btn-icon" />LinkedIn
            </a>
            <a href={CONTACT.github} class="btn btn-secondary justify-center" target="_blank" rel="noopener">
              <Icon name="github" class="btn-icon" />GitHub
            </a>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>

---
import HeroDiagram from '../../components/ui/HeroDiagram.astro';
---

<section id="propuesta" class="flex items-center gap-4 pt-8 pb-7 md:gap-12 md:pt-20 md:pb-16">
  <div class="min-w-0 flex-1">
    <h1>
      Software que se adapta a tu operación, <span class="text-accent">no al revés</span>.
    </h1>
    <p class="mt-3 max-w-[560px] text-lead leading-[1.7]">
      Desarrollo software para automatizar procesos, conectar información y
      resolver operaciones que las herramientas existentes no cubren.
    </p>
    <div class="mt-5 flex flex-col gap-2.5 md:mt-7 md:flex-row md:gap-3">
      <a href="#contacto" class="btn btn-primary justify-center">Contame tu proyecto</a>
      <a href="/proyectos" class="btn btn-secondary justify-center">Ver proyectos</a>
    </div>
  </div>

  <div class="flex w-[36%] min-w-[104px] max-w-[150px] shrink-0 justify-center md:w-[min(560px,40vw)] md:max-w-none lg:w-[min(760px,48vw)]">
    <HeroDiagram />
  </div>
</section>

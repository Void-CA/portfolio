---
// Recurso comercial descargable: el perfil en PDF. Vive en `public/` para poder
// descargarse tal cual; la fuente editable del documento está en `docs/`.
const PROFILE = {
  href: "/perfil-comercial.pdf",
  meta: "Perfil comercial · Servicios de desarrollo de software y datos · PDF · 8 páginas",
};
---

<section id="perfil-comercial" class="py-section">
  <div class="flex flex-col gap-6 rounded-2xl border border-border bg-surface p-7 max-md:gap-5 max-md:p-5 sm:flex-row sm:items-center sm:justify-between sm:p-10">
    <div class="max-w-[62ch]">
      <span class="eyebrow">Perfil comercial</span>
      <h2 class="mt-3">¿Querés conocer los servicios?</h2>
      <p class="mt-3 text-base leading-[1.7] text-secondary">
        Descargá el perfil comercial con servicios, aplicaciones, un caso de trabajo
        y la forma de trabajo.
      </p>
      <p class="mt-3 font-mono text-meta text-muted">{PROFILE.meta}</p>
    </div>
    <a
      href={PROFILE.href}
      download
      class="btn btn-primary shrink-0 max-sm:w-full max-sm:justify-center"
    >
      Descargar perfil comercial →
    </a>
  </div>
</section>

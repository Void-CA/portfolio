---
import SectionHeader from '../../components/ui/SectionHeader.astro';
import ServiceNav from './services/ServiceNav.astro';
import ServicePanel from './services/ServicePanel.astro';
import ServiceCarousel from './services/ServiceCarousel.astro';
import { getCollection } from 'astro:content';
import { buildServiceSummaries } from '../../data/services';
import { CONTACT } from '../../components/SiteConfig';

// La sección es una proyección de descubrimiento: identidad + description +
// visual conceptual. El detalle completo vive en /servicios/[slug].
const summaries = buildServiceSummaries(await getCollection('services'));
---

<section id="servicios" class="py-section">
  <SectionHeader title="¿Qué necesitás resolver?" link={{ href: "#como-trabajo", label: "Ver cómo trabajo →" }} />
  <p class="section-intro">
    Desarrollo software alrededor de tu operación. No necesitás llegar con una
    solución definida: podemos empezar por el problema.
  </p>
  <p class="mt-3 text-ui text-muted">
    ¿No sabés cuál? <a href={`mailto:${CONTACT.email}`} class="font-semibold text-accent hover:text-accent-strong">Contame el problema y lo vemos.</a>
  </p>

  <div class="mt-14 max-md:mt-8" data-services>
    <div class="hidden lg:block">
      <ServiceNav services={summaries} />
    </div>

    {summaries.map((service, i) => (
      <ServicePanel service={service} active={i === 0} />
    ))}

    <ServiceCarousel services={summaries} />
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-services]');
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-service-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-service-panel]'));
    const desktop = window.matchMedia('(min-width: 1024px)');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const select = (index: number, options: { focus?: boolean; reveal?: boolean } = {}) => {
      tabs.forEach((tab, i) => {
        const active = i === index;
        tab.setAttribute('aria-selected', active ? 'true' : 'false');
        tab.tabIndex = active ? 0 : -1;
      });
      panels.forEach((panel, i) => panel.classList.toggle('is-active', i === index));
      if (options.focus) tabs[index].focus();
      if (options.reveal && !desktop.matches) {
        panels[index].scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      }
    };

    tabs.forEach((tab, i) => tab.addEventListener('click', () => select(i, { reveal: true })));

    root.addEventListener('keydown', (event: KeyboardEvent) => {
      const current = tabs.findIndex(tab => tab.getAttribute('aria-selected') === 'true');
      let next = current;

      switch (event.key) {
        case 'ArrowRight':
        case 'ArrowDown': next = (current + 1) % tabs.length; break;
        case 'ArrowLeft':
        case 'ArrowUp': next = (current - 1 + tabs.length) % tabs.length; break;
        case 'Home': next = 0; break;
        case 'End': next = tabs.length - 1; break;
        default: return;
      }

      event.preventDefault();
      select(next, { focus: true });
    });
  }

  const carousel = document.querySelector<HTMLElement>('[data-service-carousel]');
  if (carousel) {
    const track = carousel.querySelector<HTMLElement>('[data-carousel-track]');
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-carousel-slide]'));
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]'));
    const current = carousel.querySelector<HTMLElement>('[data-carousel-current]');

    if (track && slides.length > 0) {
      const setCurrent = (index: number) => {
        dots.forEach((dot, i) => dot.setAttribute('aria-current', i === index ? 'true' : 'false'));
        if (current) current.textContent = String(index + 1).padStart(2, '0');
      };

      const scrollToSlide = (index: number) => {
        const slide = slides[index];
        if (!slide) return;
        track.scrollTo({ left: slide.offsetLeft - track.offsetLeft, behavior: 'smooth' });
      };

      dots.forEach((dot, i) => dot.addEventListener('click', () => scrollToSlide(i)));

      let ticking = false;
      track.addEventListener('scroll', () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const center = track.scrollLeft + track.clientWidth / 2;
          let nearest = 0;
          let best = Infinity;
          slides.forEach((slide, i) => {
            const slideCenter = slide.offsetLeft - track.offsetLeft + slide.clientWidth / 2;
            const dist = Math.abs(slideCenter - center);
            if (dist < best) { best = dist; nearest = i; }
          });
          setCurrent(nearest);
          ticking = false;
        });
      }, { passive: true });
    }
  }
</script>

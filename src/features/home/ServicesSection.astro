---
import SectionHeader from '../../components/ui/SectionHeader.astro';
import ServiceNav from './services/ServiceNav.astro';
import ServicePanel from './services/ServicePanel.astro';
import { SERVICES } from '../../data/services';
import type { ResolvedService } from '../../data/services';
import type { ImageMetadata } from 'astro';

// El servicio es dueño de su propio visual: una imagen conceptual del servicio
// (no una captura de proyecto). Se resuelve contra src/assets/servicios/ y, si
// el archivo todavía no existe, el panel muestra un marco neutro para que todos
// los servicios conserven el mismo peso visual.
const assets = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/servicios/*.{png,jpg,jpeg,webp,avif}',
  { eager: true }
);

const services: ResolvedService[] = SERVICES.map(service => ({
  ...service,
  image: assets[`../assets/servicios/${service.image}`]?.default,
}));
---

<section id="servicios" class="py-section">
  <SectionHeader title="¿Qué necesitás resolver?" link={{ href: "#como-trabajo", label: "Ver cómo trabajo →" }} />
  <p class="section-intro">
    Desarrollo software alrededor de tu operación. No necesitás llegar con una
    solución definida: podemos empezar por el problema.
  </p>

  <div class="mt-14" data-services>
    <ServiceNav services={services} />

    {services.map((service, i) => (
      <ServicePanel service={service} active={i === 0} />
    ))}
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-services]');
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-service-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-service-panel]'));
    const desktop = window.matchMedia('(min-width: 1024px)');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const select = (index: number, options: { focus?: boolean; reveal?: boolean } = {}) => {
      tabs.forEach((tab, i) => {
        const active = i === index;
        tab.setAttribute('aria-selected', active ? 'true' : 'false');
        tab.tabIndex = active ? 0 : -1;
      });
      panels.forEach((panel, i) => panel.classList.toggle('hidden', i !== index));
      if (options.focus) tabs[index].focus();
      if (options.reveal && !desktop.matches) {
        panels[index].scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      }
    };

    tabs.forEach((tab, i) => tab.addEventListener('click', () => select(i, { reveal: true })));

    root.addEventListener('keydown', (event: KeyboardEvent) => {
      const current = tabs.findIndex(tab => tab.getAttribute('aria-selected') === 'true');
      let next = current;

      switch (event.key) {
        case 'ArrowRight':
        case 'ArrowDown': next = (current + 1) % tabs.length; break;
        case 'ArrowLeft':
        case 'ArrowUp': next = (current - 1 + tabs.length) % tabs.length; break;
        case 'Home': next = 0; break;
        case 'End': next = tabs.length - 1; break;
        default: return;
      }

      event.preventDefault();
      select(next, { focus: true });
    });
  }
</script>

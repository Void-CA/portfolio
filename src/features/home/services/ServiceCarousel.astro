---
import Icon from '../../../components/ui/Icon.astro';
import { Image } from 'astro:assets';
import type { ServiceSummary } from '../../../data/services';

interface Props {
  services: ServiceSummary[];
}

const { services } = Astro.props;
---

<div class="lg:hidden" data-service-carousel>
  <div class="flex snap-x snap-mandatory gap-4 overflow-x-auto pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" data-carousel-track>
    {services.map(service => (
      <article class="flex w-full shrink-0 snap-center flex-col gap-4 rounded-xl border border-border bg-surface p-5 max-md:gap-3 max-md:p-4" data-carousel-slide>
        {service.visual ? (
          <figure class="m-0 overflow-hidden rounded-lg border border-border bg-background">
            <Image
              src={service.visual}
              alt={service.title}
              widths={[480, 800]}
              sizes="100vw"
              loading="lazy"
              class="block aspect-[16/10] h-full w-full object-cover"
            />
          </figure>
        ) : (
          <div class="flex aspect-[16/10] items-center justify-center rounded-lg border border-border bg-accent-tint text-accent">
            <Icon name={service.icon} class="text-[2.25rem]" />
          </div>
        )}

        <div class="min-w-0">
          <h3 class="text-title tracking-[-0.01em] text-primary">{service.title}</h3>
          <p class="mt-2 text-base leading-[1.6] text-secondary">{service.description}</p>

          <a href={`/servicios/${service.id}`} class="mt-4 inline-flex items-center gap-1.5 text-ui font-semibold text-accent transition-colors hover:text-accent-strong">
            Ver servicio completo
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </article>
    ))}
  </div>

  <div class="mt-4 flex items-center justify-between">
    <span class="font-mono text-meta tabular-nums text-muted">
      <span data-carousel-current>01</span> / {String(services.length).padStart(2, "0")}
    </span>
    <div class="flex gap-0.5" data-carousel-dots>
      {services.map((_, i) => (
        <button
          type="button"
          class="group flex h-8 w-8 items-center justify-center"
          data-carousel-dot
          data-index={i}
          aria-label={`Ir al servicio ${i + 1}`}
          aria-current={i === 0 ? "true" : "false"}
        >
          <span
            class="h-1.5 w-1.5 rounded-full bg-border transition-all group-aria-[current=true]:w-5 group-aria-[current=true]:bg-accent"
            aria-hidden="true"
          ></span>
        </button>
      ))}
    </div>
  </div>
</div>

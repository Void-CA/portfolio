---
import type { ServiceSummary } from '../../../data/services';

interface Props {
  services: ServiceSummary[];
}

const { services } = Astro.props;

// Selector plano (sin categorías): cada tab es la frase-problema del cliente.
const tabClass =
  "group flex items-start gap-2 rounded-md border border-border bg-surface/50 px-3 py-2.5 text-left transition-all duration-150 " +
  "hover:border-border-strong hover:bg-surface hover:text-primary " +
  "focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent " +
  "aria-selected:border-accent/70 aria-selected:bg-accent-tint aria-selected:text-primary";
---

<div class="grid gap-2 sm:grid-cols-3 lg:grid-cols-5" role="tablist" aria-label="Servicios">
  {services.map((service, i) => (
    <button
      type="button"
      role="tab"
      id={`svc-tab-${service.id}`}
      aria-selected={i === 0 ? "true" : "false"}
      aria-controls={`svc-panel-${service.id}`}
      tabindex={i === 0 ? 0 : -1}
      data-service-tab
      class={tabClass}
    >
      <span class="shrink-0 font-mono text-base font-semibold text-accent">{service.num}</span>
      <span class="min-w-0 flex-1 text-ui font-semibold leading-[1.3] text-secondary group-hover:text-primary group-aria-selected:text-primary">
        {service.need}
      </span>
    </button>
  ))}
</div>

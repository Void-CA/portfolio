---
import SectionHeader from '../../components/ui/SectionHeader.astro';
import ProjectCard from '../../components/ui/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const featured = projects
  .filter(p => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

{featured.length > 0 && (
  <section id="evidencia" class="py-section">
    <SectionHeader title="Evidencia" link={{ href: "/proyectos", label: "Ver todos →" }} />
    <div class="grid grid-cols-1 gap-5 max-md:gap-4 md:grid-cols-2 lg:grid-cols-3">
      {featured.map((project, i) => (
        <ProjectCard project={project} class={i >= 2 ? "max-lg:hidden" : undefined} />
      ))}
    </div>
  </section>
)}

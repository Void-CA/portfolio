---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/ui/Icon.astro';
import { CONTACT } from '../components/SiteConfig';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('about', 'sobre-mi');
if (!entry) throw new Error('Falta el contenido about/sobre-mi.md');

const { data } = entry;
const { Content } = await render(entry);
const flow = data.flow ?? [];
---

<Layout title="Sobre mí" description="Ari Castillo — desarrollador de software orientado a sistemas. Software aplicado a operaciones, datos y procesos físicos.">
  <article class="mx-auto max-w-[1200px] pb-24 pt-16">
    <header>
      <p class="font-mono text-meta uppercase tracking-[0.1em] text-accent">Sobre mí</p>
      <h1 class="mt-3">{data.title}</h1>
      {data.lead && <p class="mt-5 text-lead leading-[1.7]">{data.lead}</p>}
      {data.location && (
        <p class="mt-4 font-mono text-meta text-muted">{data.location}</p>
      )}
    </header>


    <div class="prose-body mt-10 [&>p]:max-w-none [&>p]:leading-[1.8] [&>ol]:mb-4 [&>ol]:list-decimal [&>ol]:pl-5">
      <Content />
    </div>

    {data.areas && (
      <section class="mt-16 border-t border-border pt-10">
        <h2 class="text-title">Áreas de competencia</h2>
        <div class="mt-6 grid gap-6 sm:grid-cols-2">
          {data.areas.map(area => (
            <div class="flex flex-col gap-2.5">
              <span class="text-micro font-bold uppercase tracking-[0.08em] text-accent">{area.label}</span>
              <ul class="flex list-none flex-col gap-1.5">
                {area.items.map(item => (
                  <li class="relative pl-4 text-ui leading-[1.55] text-secondary before:absolute before:left-0 before:text-accent before:content-['—']">{item}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )}

    {data.interests && (
      <section class="mt-16 border-t border-border pt-10">
        <h2 class="text-title">Intereses técnicos</h2>
        <p class="mt-3 text-ui text-muted">Hacia dónde apunto, además de lo que ya uso.</p>
        <ul class="mt-5 grid list-none gap-x-8 gap-y-2 sm:grid-cols-2">
          {data.interests.map(interest => (
            <li class="relative pl-4 text-base leading-[1.5] text-primary before:absolute before:left-0 before:text-accent before:content-['—']">{interest}</li>
          ))}
        </ul>
      </section>
    )}

    <section class="mt-16 border-t border-border pt-10">
      <h2 class="text-title">Formación</h2>
      <ul class="mt-6 flex list-none flex-col divide-y divide-border">
        {data.formation.map(item => (
          <li class="flex flex-col gap-0.5 py-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
            <span class="flex flex-col gap-0.5">
              <span class="text-base font-semibold text-primary">{item.title}</span>
              <span class="text-ui text-secondary">{item.place}</span>
            </span>
            <span class="font-mono text-meta text-muted">{item.period}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-16 border-t border-border pt-10">
      <h2 class="text-title">Herramientas y tecnologías</h2>
      <p class="mt-3 text-ui text-muted">Más que una lista de herramientas, los sistemas que permiten construir.</p>
      <div class="mt-6 grid gap-x-8 gap-y-5 sm:grid-cols-2">
        {data.tools.map(group => (
          <div class="flex flex-col gap-1.5">
            <span class="text-micro font-bold uppercase tracking-[0.08em] text-accent">{group.label}</span>
            <div class="flex flex-wrap gap-2">
              {group.items.map(item => <span class="chip chip--tech">{item}</span>)}
            </div>
          </div>
        ))}
      </div>
    </section>

    <footer class="mt-16 border-t border-border pt-10">
      <p class="text-base leading-[1.8] text-secondary">
        ¿Tenés un proceso que podría convertirse en un mejor sistema?{" "}
        <a href={`mailto:${CONTACT.email}`} class="font-medium">Escribime</a>, o mirá
        los <a href="/proyectos" class="font-medium">sistemas que ya construí</a>.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={`mailto:${CONTACT.email}`} class="btn btn-primary">
          <Icon name="mail" class="btn-icon" />Escribime
        </a>
        <a href={CONTACT.linkedin} class="btn btn-secondary" target="_blank" rel="noopener">
          <Icon name="linkedin" class="btn-icon" />LinkedIn
        </a>
      </div>
    </footer>
  </article>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const specialties = await getCollection("specialties");
  return specialties.map(spec => ({
    params: { slug: spec.id },
    props: { spec },
  }));
}

const { spec } = Astro.props;
const { data, id: slug } = spec;

const allSkills = await getCollection("skills");
const allProjects = await getCollection("projects");

const competencies = data.competencies
  .map(s => allSkills.find(skill => skill.id === s))
  .filter((s): s is NonNullable<typeof s> => Boolean(s));

const featuredProjects = data.featured_projects
  .map(p => allProjects.find(project => project.id === p))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));
---

<Layout title={data.name} description={data.description}>
  <article class="specialty-detail">
    <header class="specialty-header">
      <a href="/skills" class="back-link">← Volver a especialidades</a>
      <h1>{data.name}</h1>
      <p class="description">{data.description}</p>
    </header>

    {competencies.length > 0 && (
      <section class="competencies-section">
        <h2>Competencias</h2>
        <div class="skills-grid">
          {competencies.map(skill => (
            <a href={`/skills/skill/${skill.id}/`} class="skill-link">
              <span class="skill-name">{skill.data.name}</span>
              {skill.data.statement && (
                <span class="skill-statement">{skill.data.statement}</span>
              )}
            </a>
          ))}
        </div>
      </section>
    )}

    {featuredProjects.length > 0 && (
      <section class="projects-section">
        <h2>Proyectos destacados</h2>
        <div class="projects-list">
          {featuredProjects.map(project => (
            <a href={`/proyectos/${project.id}/`} class="project-link">
              <span class="project-title">{project.data.title}</span>
              {project.data.subtitle && (
                <span class="project-subtitle">{project.data.subtitle}</span>
              )}
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</Layout>

<style>
  .specialty-detail {
    padding: 48px 0 80px;
    max-width: 720px;
  }

  .back-link {
    font-size: 0.85rem;
    color: var(--text-secondary);
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-bottom: 32px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--accent-soft);
  }

  .specialty-header h1 {
    margin-bottom: 16px;
  }

  .description {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .competencies-section,
  .projects-section {
    margin-top: 48px;
  }

  .competencies-section h2,
  .projects-section h2 {
    font-size: 1.1rem;
    margin-bottom: 20px;
  }

  .skills-grid {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .skill-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 20px;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, background 0.2s;
  }

  .skill-link:hover {
    border-color: var(--border-hover);
    background: var(--bg-surface-hover);
  }

  .skill-name {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--accent-soft);
  }

  .skill-statement {
    font-size: 0.85rem;
    color: var(--text-secondary);
    font-style: italic;
    line-height: 1.5;
  }

  .projects-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .project-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 18px 20px;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, background 0.2s, transform 0.2s;
  }

  .project-link:hover {
    border-color: var(--border-hover);
    background: var(--bg-surface-hover);
    transform: translateX(2px);
  }

  .project-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .project-subtitle {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }
</style>

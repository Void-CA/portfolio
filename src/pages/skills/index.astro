---
import Layout from '../../layouts/Layout.astro';
import SkillsList from '../../components/SkillsList.astro';
import { getCollection } from "astro:content";

const skills = await getCollection("skills");
---

<Layout title="Skills" description="Bitácora técnica: herramientas que influyeron en mi forma de diseñar software.">
  <section class="page-header">
    <h1>Skills</h1>
    <p class="desc">
      No es una lista de tecnologías. Es una bitácora técnica de herramientas
      que modificaron mi forma de pensar sistemas.
    </p>
  </section>

  <SkillsList skills={skills} />
</Layout>

<style>
  .page-header {
    padding: 64px 0 48px;
    max-width: 720px;
  }

  .desc {
    margin-top: 12px;
    font-size: 0.95rem;
    line-height: 1.7;
  }
</style>
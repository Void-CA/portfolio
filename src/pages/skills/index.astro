---
import Layout from '../../layouts/Layout.astro';
import SpecialtiesList from '../../components/SpecialtiesList.astro';
import { getCollection } from "astro:content";

const specialties = await getCollection("specialties");
const skills = await getCollection("skills");
const projects = await getCollection("projects");
---

<Layout title="Especialidades" description="Capacidades demostradas a través de proyectos. Lo que sé hacer, no solo las tecnologías que conozco.">
  <section class="page-header">
    <h1>Especialidades</h1>
    <p class="desc">
      Capacidades demostradas a través de proyectos, no listas de
      tecnologías. Cada especialidad agrupa competencias y proyectos
      donde se aplicaron, con énfasis en el tipo de problema que
      resuelve y la decisión arquitectónica que la sostiene.
    </p>
  </section>

  <SpecialtiesList specialties={specialties} skills={skills} projects={projects} />
</Layout>

<style>
  .page-header {
    padding: 64px 0 48px;
    max-width: 720px;
  }

  .desc {
    margin-top: 12px;
    font-size: 0.95rem;
    line-height: 1.7;
  }
</style>

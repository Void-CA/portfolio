---
import Layout from '../../layouts/Layout.astro';
import SkillsList from '../../components/SkillsList.astro';
import { getCollection } from "astro:content";

const skills = await getCollection("skills");
---

<Layout title="Áreas" description="Áreas de competencia técnica: modelado, sistemas, datos y más.">
  <section class="page-header">
    <h1>Áreas de competencia</h1>
    <p class="desc">
      No es una lista de tecnologías. Son áreas de pensamiento y diseño donde
      tengo experiencia real resolviendo problemas. Cada una incluye contexto,
      decisiones y proyectos donde se aplicó.
    </p>
  </section>

  <SkillsList skills={skills} />
</Layout>

<style>
  .page-header {
    padding: 64px 0 48px;
    max-width: 720px;
  }

  .desc {
    margin-top: 12px;
    font-size: 0.95rem;
    line-height: 1.7;
  }
</style>
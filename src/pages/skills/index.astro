---
import Layout from '../../layouts/Layout.astro';
import SkillCard from '../../components/SkillCard.astro';
import { getCollection } from "astro:content";

const skills = await getCollection("skills");
const sorted = skills.sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Skills" description="Habilidades demostradas con contexto real: problemas resueltos, proyectos donde se aplicaron, decisiones técnicas.">
  <section class="page-header">
    <h1>Habilidades</h1>
    <p class="desc">
      No es una lista de tecnologías que toqué una vez. Cada skill viene con el contexto
      real: qué problemas resolví, en qué proyectos se usó, y qué tipo de decisiones tomé.
    </p>
  </section>

  <section class="skills-grid">
    {sorted.map(skill => <SkillCard skill={skill} />)}
  </section>
</Layout>

<style>
  .page-header {
    padding: 64px 0 40px;
    max-width: 640px;
  }

  .desc {
    margin-top: 12px;
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 20px;
    padding-bottom: 80px;
  }

  @media (max-width: 768px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

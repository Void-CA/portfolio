---
import Layout from '../../layouts/Layout.astro';
import ServiceTile from '../../components/ui/ServiceTile.astro';
import { getCollection } from 'astro:content';
import { buildServiceSummaries } from '../../data/services';

const services = buildServiceSummaries(await getCollection('services'));

// Bento de 5: el primero es el hero; el resto en una grilla que en móvil pasa a
// una lista apilada (1 columna) y en sm/lg recupera la forma de bento.
const spans = [
  'col-span-1 sm:col-span-2 lg:col-span-6',
  'col-span-1 lg:col-span-3',
  'col-span-1 lg:col-span-3',
  'col-span-1 lg:col-span-3',
  'col-span-1 lg:col-span-3',
];
const variants = ['feature', 'wide', 'wide', 'wide', 'wide'] as const;
---

<Layout
  title="Servicios"
  description="Software y datos alrededor de tu operación: desarrollo de software, análisis y ciencia de datos, ingeniería de datos, automatización y sistemas industriales."
>
  <section class="max-w-[840px] pb-8 pt-16 max-md:pb-6 max-md:pt-10">
    <h1>Servicios</h1>
    <p class="mt-3 text-base leading-[1.7]">
      Software alrededor de tu operación. No necesitás llegar con una solución
      definida: podemos empezar por el problema. Entrá a cada servicio para ver
      qué problema resuelve y cómo se construye.
    </p>
  </section>

  <section class="pb-20 max-md:pb-12">
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-4 lg:grid-cols-6">
      {services.map((service, i) => (
        <ServiceTile
          service={service}
          variant={variants[i] ?? 'compact'}
          class={spans[i] ?? 'lg:col-span-2'}
        />
      ))}
    </div>
  </section>
</Layout>

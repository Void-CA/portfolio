---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Icon from '../components/Icon.astro';
import SectionHeader from '../components/SectionHeader.astro';
import HeroDiagram from '../components/HeroDiagram.astro';
import { CONTACT } from '../components/SiteConfig';
import { SERVICES } from '../data/services';
import { Image } from 'astro:assets';
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
const featured = projects
  .filter(p => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const projectsById = new Map(projects.map(p => [p.id, p]));

// El servicio declara qué evidencia lo respalda; el proyecto es dueño de sus assets.
// `evidence.image` es una clave semántica de la galería del proyecto; si falta,
// se usa la portada. Un proyecto sin imagen no recibe placeholder.
const resolvedServices = SERVICES.map(service => {
  const project = projectsById.get(service.evidence.project);
  if (!project) return { service, evidence: null };

  const { data } = project;
  let image = data.image;
  let imageAlt = data.imageAlt ?? `Captura de ${data.title}`;

  if (service.evidence.image && data.images) {
    const match = data.images.find(img => img.key === service.evidence.image);
    if (match) {
      image = match.src;
      imageAlt = match.alt;
    }
  }

  return {
    service,
    evidence: {
      href: `/proyectos/${project.id}`,
      label: data.brand ?? data.title,
      image,
      imageAlt,
    },
  };
});

const steps = [
  {
    icon: "target",
    title: "Entender",
    text: "Antes de hablar de tecnología, entiendo cómo funciona realmente tu operación, qué problema existe y qué restricciones tenemos.",
  },
  {
    icon: "cube",
    title: "Construir",
    text: "Definimos una solución concreta y la desarrollamos por etapas, validando que cada parte resuelva el problema real.",
  },
  {
    icon: "check",
    title: "Entregar",
    text: "El objetivo no es una demo: dejo el sistema funcionando, documentado y con el conocimiento para continuar (código y decisiones explicadas).",
  },
  {
    icon: "trending",
    title: "Evolucionar",
    text: "El negocio cambia. El sistema también puede hacerlo sin empezar de cero.",
  },
];

const techLine = ["Rust", "TypeScript", "PostgreSQL", "Node.js", "Docker", "WebAssembly"];
---

<Layout title="Inicio" description="Desarrollo software y sistemas personalizados para automatizar procesos, integrar datos y construir herramientas adaptadas a cada operación.">
  <section class="hero" id="propuesta">
    <div class="hero-content">
      <p class="availability"><span class="availability-dot" aria-hidden="true"></span>Disponible para proyectos freelance</p>
      <h1>
        Software que se adapta a tu operación, <span class="highlight">no al revés</span>.
      </h1>
      <p class="hero-desc">
        Desarrollo software para automatizar procesos, conectar información y
        resolver operaciones que las herramientas existentes no cubren.
      </p>
      <div class="hero-cta">
        <a href="#contacto" class="btn btn-primary">Contame tu proyecto</a>
        <a href="/proyectos" class="btn btn-secondary">Ver proyectos</a>
      </div>
    </div>

    <div class="hero-visual">
      <HeroDiagram />
    </div>
  </section>

  <section class="services" id="servicios">
    <SectionHeader title="¿Qué necesitás resolver?" />
    <p class="section-intro">
      No necesitás llegar con una solución definida. Podemos empezar por el problema.
    </p>

    <div class="services-widget" data-services>
      {resolvedServices.map(({ service, evidence }, i) => (
        <div class="service">
          <button
            type="button"
            class="service-head"
            data-index={i}
            aria-expanded={i === 0 ? "true" : "false"}
            aria-controls={`svc-${service.id}`}
          >
            <span class="service-num">{service.num}</span>
            <Icon name={service.icon} class="service-icon" />
            <span class="service-problem">{service.problem}</span>
          </button>

          <article
            id={`svc-${service.id}`}
            class:list={["service-panel", { "is-active": i === 0, "is-open": i === 0 }]}
            data-index={i}
            role="region"
            aria-labelledby={`svc-${service.id}-title`}
          >
            <div class:list={["panel-body", { "has-media": Boolean(evidence?.image) }]}>
              <span class="panel-num" aria-hidden="true">{service.num}</span>
              <Icon name={service.icon} class="panel-icon" />
              <h3 class="panel-title" id={`svc-${service.id}-title`}>{service.title}</h3>
              <p class="panel-desc">{service.description}</p>

              {evidence?.image && (
                <figure class="panel-media">
                  <Image src={evidence.image} alt={evidence.imageAlt} loading="lazy" />
                </figure>
              )}

              <div class="panel-changes">
                <span class="panel-label">Qué cambia</span>
                <ul>
                  {service.changes.map(change => <li>{change}</li>)}
                </ul>
              </div>

              <div class="flow" aria-hidden="true">
                {service.flow.map((step, idx) => (
                  <>
                    <span class="flow-step">{step}</span>
                    {idx < service.flow.length - 1 && <span class="flow-sep">→</span>}
                  </>
                ))}
              </div>

              {evidence && (
                <a class="panel-evidence" href={evidence.href}>
                  Ejemplo: {evidence.label} →
                </a>
              )}
            </div>
          </article>
        </div>
      ))}
    </div>
  </section>

  <section class="process" id="como-trabajo">
    <SectionHeader title="Cómo trabajo" />
    <p class="section-intro">
      Un proceso claro, de principio a fin. Desde entender el problema hasta
      dejar una solución que pueda evolucionar.
    </p>

    <div class="timeline" data-timeline>
      <div class="timeline-rail" aria-hidden="true">
        <div class="timeline-progress"></div>
      </div>
      <ol class="timeline-steps">
        {steps.map((step, i) => (
          <li class="milestone">
            <span class="milestone-dot" aria-hidden="true"></span>
            <span class="milestone-num">{String(i + 1).padStart(2, "0")}</span>
            <h3><Icon name={step.icon} class="milestone-icon" />{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {featured.length > 0 && (
    <section class="featured" id="evidencia">
      <SectionHeader title="Evidencia" link={{ href: "/proyectos", label: "Ver todos →" }} />
      <div class="grid">
        {featured.map(project => <ProjectCard project={project} />)}
      </div>
    </section>
  )}

  <section class="about" id="sobre-mi">
    <SectionHeader title="Sobre mí" />
    <div class="about-content">
      <div class="about-narrative">
        <p>
          Soy Ari Castillo, desarrollador de software. Trabajo con organizaciones
          que tienen procesos específicos que las herramientas genéricas no cubren
          bien: procesos manuales, información dispersa o sistemas que ya no se
          ajustan a cómo opera el negocio.
        </p>
        <p>
          Construyo sistemas claros, mantenibles y preparados para evolucionar,
          sobre todo cuando hay restricciones que una solución estándar no puede
          resolver.
        </p>
        <p>
          Trabajo de forma independiente desde Nicaragua. Puedo trabajar de manera
          virtual con clientes de todo el país y de forma presencial cuando el
          proyecto lo requiere, especialmente en la zona occidental.
        </p>
      </div>
      <aside class="about-meta">
        <p class="provider-meta">Español · Inglés · UTC−6</p>
        <div class="tech-line">
          <span class="tech-label">Tecnologías que uso</span>
          <div class="tech-tags">
            {techLine.map(t => <span class="chip chip--tech">{t}</span>)}
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="contact" id="contacto">
    <div class="contact-inner">
      <SectionHeader title="Contame qué necesitás" />
      <p>
        Si tenés un proceso que se puede automatizar, datos dispersos que deberían
        hablar entre sí o una herramienta que no encaja, escribime. Te respondo con
        un diagnóstico honesto, aunque no sea lo que querés escuchar.
      </p>

      <ol class="contact-steps">
        <li>Me escribís</li>
        <li>Entiendo el problema</li>
        <li>Primera conversación</li>
        <li>Definimos si avanzar</li>
      </ol>

      <div class="contact-cta">
        <a href={`mailto:${CONTACT.email}`} class="btn btn-primary">
          <Icon name="mail" class="btn-icon" />{CONTACT.email}
        </a>
        <a href={CONTACT.linkedin} class="btn btn-secondary" target="_blank" rel="noopener">
          <Icon name="linkedin" class="btn-icon" />LinkedIn
        </a>
      </div>

      <p class="contact-note">
        No necesitás preparar una especificación técnica ni saber exactamente qué
        solución necesitás.
      </p>

      <div class="contact-dimension">
        <span class="contact-label">Cómo se dimensiona</span>
        <p>
          Los proyectos se cotizan según alcance y complejidad. Cuando el problema
          todavía no está definido, podemos empezar por una etapa de diagnóstico y
          definición antes de comprometer el desarrollo completo.
        </p>
      </div>

      <p class="contact-note">
        La entrega incluye documentación y el conocimiento necesario para continuar
        el sistema. Después podemos acordar mantenimiento o nuevas etapas según lo
        que necesites.
      </p>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding: 80px 0 64px;
    display: flex;
    gap: 48px;
    align-items: center;
  }

  .hero-content {
    flex: 1;
    max-width: 620px;
  }

  .availability {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-secondary);
    margin-bottom: 18px;
  }

  .availability-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }

  .hero-visual {
    flex-shrink: 0;
    width: 260px;
    display: flex;
    justify-content: center;
  }

  .hero-content h1 .highlight {
    color: var(--accent);
  }

  .hero-content .hero-desc {
    font-size: 1.1rem;
    line-height: 1.7;
    max-width: 560px;
    margin-top: 16px;
  }

  .hero-content .hero-cta {
    display: flex;
    gap: 12px;
    margin-top: 28px;
  }

  .services {
    padding: var(--section-gap) 0;
  }

  .services-widget {
    margin-top: 32px;
    background: var(--accent-tint);
    border-radius: 16px;
    padding: 40px;
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.75fr);
    column-gap: 36px;
    align-items: start;
  }

  .service {
    display: contents;
  }

  .service-head {
    grid-column: 1;
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    text-align: left;
    background: transparent;
    border: 0;
    border-top: 1px solid rgba(15, 118, 110, 0.15);
    padding: 18px 0;
    cursor: pointer;
    font-family: inherit;
    color: var(--text-secondary);
    transition: color 0.15s;
  }

  .service-head::before {
    content: "";
    position: absolute;
    left: -14px;
    top: 12px;
    bottom: 12px;
    width: 3px;
    border-radius: 2px;
    background: transparent;
    transition: background-color 0.15s;
  }

  .service-head.is-active::before {
    background: var(--accent);
  }

  .service-head:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .service:first-child .service-head {
    border-top: 0;
    padding-top: 0;
  }

  .service-head:hover .service-problem {
    color: var(--text-primary);
  }

  .service-head.is-active .service-problem {
    color: var(--accent);
    font-weight: 600;
  }

  .service-num {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
    flex-shrink: 0;
  }

  .service-icon {
    font-size: 1.2rem;
    color: var(--text-muted);
    transition: color 0.15s;
  }

  .service-head.is-active .service-icon {
    color: var(--accent);
  }

  .service-problem {
    font-size: 0.95rem;
    line-height: 1.4;
    transition: color 0.15s;
  }

  .service-panel {
    grid-column: 2;
    grid-row: 1 / span 5;
    position: relative;
    display: none;
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 36px 36px 32px;
  }

  .service-panel.is-active {
    display: block;
  }

  .panel-body {
    position: relative;
    min-width: 0;
  }

  /* Con evidencia visual, el panel se compone en dos columnas: texto y captura.
     Sin media, se mantiene en una sola columna. */
  @media (min-width: 861px) {
    .panel-body.has-media {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: 36px;
      align-items: start;
    }

    .panel-body.has-media > :not(.panel-media) {
      grid-column: 1;
    }

    .panel-body.has-media > .panel-media {
      grid-column: 2;
      grid-row: 1 / span 6;
      margin: 0;
    }
  }

  .panel-media {
    position: relative;
    width: 100%;
    margin: 24px 0;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    background: var(--bg-surface);
    box-shadow: var(--shadow-subtle);
  }

  .panel-media img {
    width: 100%;
    height: auto;
    display: block;
  }

  .panel-num {
    position: absolute;
    top: -18px;
    right: 4px;
    font-size: clamp(80px, 10vw, 128px);
    font-weight: 700;
    line-height: 1;
    color: rgba(15, 118, 110, 0.08);
    pointer-events: none;
    user-select: none;
  }

  .panel-icon {
    position: relative;
    display: block;
    font-size: 1.6rem;
    color: var(--accent);
    margin-bottom: 14px;
  }

  .panel-title {
    position: relative;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    margin-bottom: 12px;
  }

  .panel-desc {
    position: relative;
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .panel-changes {
    position: relative;
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
  }

  .panel-label {
    display: block;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 12px;
  }

  .panel-changes ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .panel-changes li {
    position: relative;
    padding-left: 20px;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--text-primary);
  }

  .panel-changes li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  .service-panel .flow {
    position: relative;
    margin-top: 24px;
  }

  .panel-evidence {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 24px;
    padding: 9px 14px;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    transition: border-color 0.2s, background-color 0.2s, color 0.2s;
  }

  .panel-evidence:hover {
    border-color: var(--accent);
    background: var(--accent-tint);
  }

  .process {
    padding: var(--section-gap) 0;
  }

  .timeline {
    position: relative;
    margin-top: 56px;
  }

  .timeline-rail {
    position: absolute;
    top: 5px;
    left: 0;
    right: 0;
    height: 2px;
    background: rgba(15, 118, 110, 0.18);
  }

  .timeline-progress {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: calc(var(--progress, 0) * 100%);
    background: var(--accent);
    transition: width 0.15s linear;
  }

  .timeline-steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0 24px;
  }

  .milestone {
    position: relative;
    padding-top: 44px;
  }

  .milestone-dot {
    position: absolute;
    top: 0;
    left: 0;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--bg-primary);
    border: 2px solid rgba(15, 118, 110, 0.35);
    transition: background-color 0.2s, border-color 0.2s;
  }

  .milestone.is-reached .milestone-dot {
    background: var(--accent);
    border-color: var(--accent);
  }

  .milestone-num {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 8px;
  }

  .milestone-icon {
    font-size: 1.2rem;
    color: var(--accent);
  }

  .milestone h3 {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-primary);
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 8px;
  }

  .milestone p {
    font-size: 0.85rem;
    line-height: 1.6;
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline-progress,
    .milestone-dot {
      transition: none;
    }
  }

  .featured {
    padding: var(--section-gap) 0;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 20px;
  }

  .about {
    padding: var(--space-8) 0;
  }

  .about-content {
    margin-top: 0;
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: 48px;
    align-items: start;
  }

  .about-narrative {
    max-width: 640px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .about-meta {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .about-content p {
    font-size: 0.95rem;
    line-height: 1.75;
  }

  @media (max-width: 900px) {
    .about-content {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  .provider-meta {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .tech-line {
    margin-top: 8px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .tech-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    font-weight: 600;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .contact {
    padding: 80px 0 104px;
  }

  .contact-inner {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 48px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: flex-start;
  }

  .contact-inner p {
    font-size: 0.95rem;
    line-height: 1.7;
    max-width: 560px;
  }

  .contact-steps {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .contact-steps li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .contact-steps li::after {
    content: "→";
    color: var(--accent);
    margin-left: 4px;
  }

  .contact-steps li:last-child::after {
    content: "";
    margin-left: 0;
  }

  .contact-inner .contact-note {
    font-size: 0.9rem;
  }

  .contact-dimension {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px 20px;
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: 10px;
    max-width: 560px;
  }

  .contact-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    color: var(--accent);
  }

  .contact-dimension p {
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  .contact-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }

  /* La acción terminal del sitio es la que más peso visual necesita. */
  .contact-cta .btn-primary {
    box-shadow: var(--shadow-subtle);
  }

  @media (max-width: 860px) {
    .services-widget {
      display: block;
      padding: 8px 20px;
    }

    .service {
      display: block;
      border-top: 1px solid rgba(15, 118, 110, 0.15);
    }

    .service:first-child {
      border-top: 0;
    }

    .service-head {
      border-top: 0;
      padding: 18px 0;
    }

    .service:first-child .service-head {
      padding-top: 18px;
    }

    .service-panel {
      grid-row: auto;
      margin: 0 0 20px;
      padding: 24px 20px 20px;
    }

    .service-panel.is-active {
      display: none;
    }

    .service-panel.is-open {
      display: block;
    }

    .panel-num {
      font-size: 72px;
      top: -12px;
      right: 0;
      left: auto;
    }
  }

  @media (max-width: 768px) {
    .hero {
      flex-direction: column;
      gap: 32px;
      padding: 48px 0 40px;
    }

    .hero-content .hero-cta {
      flex-direction: column;
    }

    .hero-visual {
      width: 100%;
    }

    .hero-content .btn {
      justify-content: center;
    }

    .grid {
      grid-template-columns: 1fr;
    }

    .timeline-rail {
      top: 0;
      bottom: 0;
      left: 5px;
      right: auto;
      width: 2px;
      height: auto;
    }

    .timeline-progress {
      width: 100%;
      height: calc(var(--progress, 0) * 100%);
      transition: height 0.15s linear;
    }

    .timeline-steps {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .milestone {
      padding: 0 0 32px 36px;
    }

    .milestone:last-child {
      padding-bottom: 0;
    }

    .milestone-dot {
      top: 4px;
    }

    .contact-inner {
      padding: 28px;
    }

    .contact-cta {
      flex-direction: column;
      width: 100%;
    }

    .contact-cta .btn {
      justify-content: center;
      width: 100%;
    }
  }
</style>

<script>
  const widget = document.querySelector('[data-services]');
  if (widget) {
    const heads = Array.from(widget.querySelectorAll<HTMLButtonElement>('.service-head'));
    const panels = Array.from(widget.querySelectorAll<HTMLElement>('.service-panel'));
    const mq = window.matchMedia('(min-width: 861px)');

    const setActive = (index: number) => {
      heads.forEach((head, i) => {
        const active = i === index;
        head.classList.toggle('is-active', active);
        head.setAttribute('aria-expanded', active ? 'true' : 'false');
      });
      panels.forEach((panel, i) => panel.classList.toggle('is-active', i === index));
    };

    const toggleOpen = (index: number) => {
      const panel = panels[index];
      const wasOpen = panel.classList.contains('is-open');
      panels.forEach(p => p.classList.remove('is-open'));
      if (!wasOpen) panel.classList.add('is-open');
      heads.forEach((head, i) => {
        head.setAttribute('aria-expanded', !wasOpen && i === index ? 'true' : 'false');
      });
    };

    heads.forEach((head, i) => {
      head.addEventListener('click', () => {
        if (mq.matches) setActive(i);
        else toggleOpen(i);
      });
    });

    setActive(0);
    mq.addEventListener('change', () => setActive(0));
  }

  const timeline = document.querySelector<HTMLElement>('[data-timeline]');
  if (timeline) {
    const items = Array.from(timeline.querySelectorAll<HTMLElement>('.milestone'));
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let ticking = false;

    const paint = () => {
      ticking = false;
      const rect = timeline.getBoundingClientRect();
      const vh = window.innerHeight || document.documentElement.clientHeight;
      const start = vh * 0.85;
      const end = vh * 0.25;
      const span = start - end + rect.height;
      const progress = span > 0 ? (start - rect.top) / span : 1;
      const clamped = Math.max(0, Math.min(1, progress));
      timeline.style.setProperty('--progress', reduce ? '1' : clamped.toFixed(3));
      items.forEach((item, i) => {
        const threshold = (i + 0.5) / items.length;
        item.classList.toggle('is-reached', reduce || clamped >= threshold);
      });
    };

    const request = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(paint);
      }
    };

    if (reduce) {
      paint();
    } else {
      window.addEventListener('scroll', request, { passive: true });
      window.addEventListener('resize', request);
      paint();
    }
  }
</script>

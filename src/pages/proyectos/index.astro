---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import FilterPills from '../../components/FilterPills.astro';
import { getCollection } from "astro:content";

const projects = await getCollection("projects");

// Extraer todos los tech únicos
const allTech = [...new Set(projects.flatMap(p => p.data.tech))].sort();
const allAreas = [...new Set(projects.flatMap(p => p.data.areas || []))].sort();

// Categorización de tecnologías
const categories: Record<string, string[]> = {
  "Lenguajes": allTech.filter(t => ["Rust", "TypeScript", "Python"].includes(t)),
  "Frameworks": allTech.filter(t => ["Django", "React", "Celery", "sysinfo", "serde"].includes(t)),
  "Infraestructura": allTech.filter(t => ["PostgreSQL", "Redis"].includes(t)),
};

// Si hay tecnologías no categorizadas, agregarlas a "Otros"
const categorized = new Set(Object.values(categories).flat());
const others = allTech.filter(t => !categorized.has(t));
if (others.length > 0) {
  categories["Otros"] = others;
}
---

<Layout title="Proyectos" description="Casos de estudio: problemas reales, decisiones técnicas, resultados.">
  <section class="page-header">
    <h1>Proyectos</h1>
    <p class="desc">
      No son listas. Son casos de estudio. Cada uno responde: qué problema existía,
      qué reto técnico implicó, qué se construyó y qué resultado tuvo.
    </p>
  </section>

  <div class="content-wrapper" id="projects-view">
    <FilterPills categories={categories} areas={allAreas} />

    <div class="projects-grid">
      {projects
        .sort((a, b) => a.data.order - b.data.order)
        .map(project => (
          <div
            class="project-item"
            data-techs={project.data.tech.map(t => t.toLowerCase()).join(",")}
            data-areas={(project.data.areas || []).join(",")}
          >
            <ProjectCard project={project} />
          </div>
        ))}
    </div>
  </div>
</Layout>

<style>
  .page-header {
    padding: 64px 0 32px;
    max-width: 640px;
  }

  .desc {
    margin-top: 12px;
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .content-wrapper {
    padding: 0 0 80px;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 20px;
    align-items: stretch;
  }

  .project-item {
    display: flex;
  }

  .project-item :global(.card) {
    height: 100%;
    min-height: 280px;
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }

    .project-item :global(.card) {
      min-height: auto;
    }
  }
</style>

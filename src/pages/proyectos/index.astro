---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
const sorted = projects.sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Proyectos" description="Casos de estudio: problemas reales, qué construí y qué resultado dejó.">
  <section class="page-header">
    <h1>Proyectos</h1>
    <p class="desc">
      Casos de estudio, no un catálogo. Cada uno responde qué problema existía,
      qué se construyó y qué resultado dejó. Menos proyectos, más claridad.
    </p>
  </section>

  <section class="content-wrapper">
    <div class="projects-grid">
      {sorted.map(project => <ProjectCard project={project} />)}
    </div>
  </section>
</Layout>

<style>
  .page-header {
    padding: 64px 0 32px;
    max-width: 640px;
  }

  .desc {
    margin-top: 12px;
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .content-wrapper {
    padding: 16px 0 80px;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 20px;
    align-items: stretch;
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

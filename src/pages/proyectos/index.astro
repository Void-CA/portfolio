---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ui/ProjectCard.astro';
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
const sorted = projects.sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Proyectos" description="Proyectos reales: qué problema había, qué se construyó y qué resultado dejó.">
  <section class="max-w-[840px] pb-8 pt-16">
    <h1>Proyectos</h1>
    <p class="mt-3 text-base leading-[1.7]">
      Sistemas que construí para resolver problemas concretos. De cada uno cuento
      qué problema había, qué se construyó y qué resultado dejó.
    </p>
  </section>

  <section class="pb-20 pt-4">
    <div class="grid grid-cols-[repeat(auto-fill,minmax(420px,1fr))] items-stretch gap-5 max-md:grid-cols-1">
      {sorted.map(project => <ProjectCard project={project} />)}
    </div>
  </section>
</Layout>

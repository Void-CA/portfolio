---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from "astro:content";

const projects = await getCollection("projects");

// Extraer todos los tech únicos
const allTech = [...new Set(projects.flatMap(p => p.data.tech))].sort();
---

<Layout title="Proyectos" description="Casos de estudio: problemas reales, decisiones técnicas, resultados.">
  <section class="page-header">
    <h1>Proyectos</h1>
    <p class="desc">
      No son listas. Son casos de estudio. Cada uno responde: qué problema existía,
      qué se construyó, por qué se decidió así y qué resultado tuvo.
    </p>
  </section>

  <div class="content-wrapper" id="projects-view">
    <aside class="sidebar">
      <h3>Filtrar por tecnología</h3>
      <ul class="tech-filters">
        <li>
          <button class="filter-btn active" data-tech="all">Todos</button>
        </li>
        {allTech.map(tech => (
          <li>
            <button class="filter-btn" data-tech={tech.toLowerCase()}>{tech}</button>
          </li>
        ))}
      </ul>
    </aside>

    <div class="projects-grid">
      {projects
        .sort((a, b) => a.data.order - b.data.order)
        .map(project => (
          <div class="project-item" data-techs={project.data.tech.map(t => t.toLowerCase()).join(",")}>
            <ProjectCard project={project} />
          </div>
        ))}
    </div>
  </div>
</Layout>

<script is:inline>
  function initFilters() {
    const buttons = document.querySelectorAll('.filter-btn');
    const items = document.querySelectorAll('.project-item');

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        buttons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const tech = btn.getAttribute('data-tech');

        items.forEach(item => {
          const itemTech = item.getAttribute('data-techs') || '';
          if (tech === 'all' || itemTech.includes(tech)) {
            item.style.display = '';
          } else {
            item.style.display = 'none';
          }
        });
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initFilters);
</script>

<style>
  .page-header {
    padding: 64px 0 40px;
    max-width: 640px;
  }

  .desc {
    margin-top: 12px;
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .content-wrapper {
    display: flex;
    gap: 40px;
    padding-bottom: 80px;
  }

  .sidebar {
    width: 220px;
    flex-shrink: 0;
  }

  .sidebar h3 {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    margin-bottom: 16px;
    font-weight: 600;
  }

  .tech-filters {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .filter-btn {
    background: none;
    border: none;
    color: var(--text-secondary);
    font-size: 0.85rem;
    padding: 8px 12px;
    text-align: left;
    cursor: pointer;
    border-radius: 6px;
    transition: all 0.15s;
    width: 100%;
    font-weight: 500;
  }

  .filter-btn:hover {
    background: var(--bg-surface);
    color: var(--text-primary);
  }

  .filter-btn.active {
    background: var(--accent-glow);
    color: var(--accent-soft);
  }

  .projects-grid {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 20px;
  }

  @media (max-width: 768px) {
    .content-wrapper {
      flex-direction: column;
    }

    .sidebar {
      width: 100%;
    }

    .tech-filters {
      flex-direction: row;
      flex-wrap: wrap;
    }

    .filter-btn {
      width: auto;
    }

    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

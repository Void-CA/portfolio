---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import Icon from '../../components/Icon.astro';
import Gallery from '../../components/Gallery.astro';
import { CONTACT } from '../../components/SiteConfig';
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map(project => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const statusLabels = {
  ongoing: "En desarrollo",
  finished: "Entregado",
  archived: "Exploración",
} as const;

const statusStyles: Record<string, string> = {
  ongoing: "border-[rgba(202,138,4,0.35)] text-[#A16207]",
  finished: "border-[rgba(15,118,110,0.3)] text-accent",
  archived: "border-border text-muted",
};

const originLabels: Record<string, string> = {
  client: "Trabajo para cliente",
  own: "Proyecto propio",
};

const statusLabel = statusLabels[data.status];
const originLabel = data.kind ? originLabels[data.kind] : "";

const images = data.images ?? [];
const improvements = data.improvements ?? [];
const decisions = data.decisions ?? [];

const hasPreview = Boolean(data.image);
const hasImprovements = improvements.length > 0;
const hasResult = Boolean(data.result) || hasImprovements;
const hasDecisions = decisions.length > 0;
---

<Layout title={data.title} description={data.description}>
  <article class="py-12 pb-20 max-md:py-8 max-md:pb-16">
    <a href="/proyectos" class="mb-8 inline-flex items-center gap-1 text-ui text-secondary transition-colors hover:text-accent">← Volver a proyectos</a>

    <header class:list={["mb-12 grid gap-10", hasPreview && "lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:items-start"]}>
      <div class="flex max-w-[68ch] flex-col gap-5">
        {data.brand && <p class="text-micro font-bold uppercase tracking-[0.1em] text-accent">{data.brand}</p>}
        <h1 class="m-0">{data.title}</h1>
        {data.subtitle && <p class="text-lead text-secondary">{data.subtitle}</p>}

        <div class="flex flex-wrap items-center gap-4">
          <span class:list={["rounded border px-2 py-1 text-micro font-medium uppercase tracking-[0.05em]", statusStyles[data.status]]}>{statusLabel}</span>
          {originLabel && (
            <span class="text-meta text-secondary">{originLabel}{data.clientNote && ` · ${data.clientNote}`}</span>
          )}
          <span class="text-ui text-muted">{data.date.toLocaleDateString("es-AR", { year: "numeric", month: "long" })}</span>
        </div>
      </div>

      {hasPreview && (
        <figure class="order-first m-0 overflow-hidden rounded-lg border border-border bg-surface shadow-card lg:order-none">
          <Image
            src={data.image!}
            alt={data.imageAlt ?? `Captura de ${data.title}`}
            loading="eager"
            class="block h-auto w-full"
          />
        </figure>
      )}
    </header>

    {(data.problem || data.solution) && (
      <section class="mb-12 grid gap-6 max-md:mb-8 md:grid-cols-2 md:gap-x-10 md:gap-y-7">
        {data.problem && (
          <div class="flex flex-col gap-2 border-l-2 border-border pl-5">
            <span class="eyebrow"><Icon name="target" class="text-sm" />Reto</span>
            <p class="text-base leading-[1.75] text-secondary">{data.problem}</p>
          </div>
        )}

        {data.solution && (
          <div class="flex flex-col gap-2 border-l-2 border-border pl-5">
            <span class="eyebrow"><Icon name="cube" class="text-sm" />Solución</span>
            <p class="text-base leading-[1.75] text-secondary">{data.solution}</p>
          </div>
        )}
      </section>
    )}

    {hasResult && (
      <section class="mb-12 border-t border-border pt-8">
        <span class="eyebrow"><Icon name="trending" class="text-base" />Resultado</span>

        {data.result && <p class="mt-4 text-lead leading-[1.7] text-primary">{data.result}</p>}

        {hasImprovements && (
          <div class="mt-8 grid gap-4 sm:grid-cols-2">
            {improvements.map(item => (
              <div class="flex flex-col gap-3 rounded-md border border-border bg-surface p-5">
                <span class="text-micro font-bold uppercase tracking-[0.08em] text-accent">{item.label}</span>

                {item.before && (
                  <div class="flex flex-col gap-1">
                    <span class="text-micro font-semibold uppercase tracking-[0.08em] text-muted">{item.beforeLabel ?? "Antes"}</span>
                    <span class="text-ui leading-[1.6] text-secondary">{item.before}</span>
                  </div>
                )}

                <div class="flex flex-col gap-1">
                  <span class="text-micro font-semibold uppercase tracking-[0.08em] text-muted">Ahora</span>
                  <span class="text-base leading-[1.6] text-primary">
                    {item.value && <strong class="mr-1 text-title font-bold text-accent-strong">{item.value}</strong>}
                    {item.after}
                  </span>
                </div>
              </div>
            ))}
          </div>
        )}
      </section>
    )}

    <Gallery images={images} />

    <details class="mb-10 border-y border-border">
      <summary class="flex cursor-pointer list-none items-center py-5 text-ui font-semibold text-accent after:ml-auto after:font-normal after:content-['+'] [details[open]_&]:after:content-['–'] [&::-webkit-details-marker]:hidden">
        Detalle técnico (arquitectura, decisiones y stack)
      </summary>
      <div class="flex flex-col gap-7 pb-8">
        {data.architecture && (
          <div class="flex flex-col gap-2 border-l-2 border-border pl-5">
            <span class="eyebrow"><Icon name="layers" class="text-sm" />Arquitectura</span>
            <p class="max-w-[76ch] text-base leading-[1.75] text-secondary">{data.architecture}</p>
          </div>
        )}

        {data.challenge && (
          <div class="flex flex-col gap-2 border-l-2 border-border pl-5">
            <span class="eyebrow"><Icon name="sliders" class="text-sm" />Reto técnico</span>
            <p class="max-w-[76ch] text-base leading-[1.75] text-secondary">{data.challenge}</p>
          </div>
        )}

        <div class="prose-body">
          <Content />
        </div>

        {hasDecisions && (
          <section>
            <h2 class="mb-4 text-title">Decisiones técnicas</h2>
            <div class="grid grid-cols-[repeat(auto-fill,minmax(260px,1fr))] gap-3">
              {decisions.map(d =>
                typeof d === "string"
                  ? <p class="relative col-span-full pl-6 text-base leading-[1.65] text-secondary before:absolute before:left-0 before:text-accent before:content-['—']">{d}</p>
                  : (
                    <div class="flex flex-col gap-1 rounded-sm border border-border bg-surface px-4 py-3">
                      <span class="text-micro font-bold uppercase tracking-[0.06em] text-accent">{d.label}</span>
                      <span class="text-base leading-[1.55] text-secondary">{d.detail}</span>
                    </div>
                  )
              )}
            </div>
          </section>
        )}

        <section>
          <h2 class="mb-4 text-title">Stack</h2>
          <div class="flex flex-wrap gap-2">
            {data.tech.map(t => <span class="chip chip--tech">{t}</span>)}
          </div>
        </section>
      </div>
    </details>

    <footer class="flex flex-wrap gap-3 border-t border-border pt-6">
      {data.repo && data.repo !== "#" && (
        <a href={data.repo} class="btn btn-secondary" target="_blank" rel="noopener">Ver repositorio</a>
      )}
      {data.live && data.live !== "#" && (
        <a href={data.live} class="btn btn-secondary" target="_blank" rel="noopener">Demo en vivo</a>
      )}
      <a href={`mailto:${CONTACT.email}`} class="btn btn-primary">¿Un problema similar? Escribime</a>
    </footer>
  </article>
</Layout>

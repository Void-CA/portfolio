---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map(project => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data, id: slug } = project;

// Notas técnicas asociadas a este proyecto — renderizadas inline
const allNotes = await getCollection("notes");
const relatedNotes = allNotes
  .filter(n => n.data.published && n.data.project === slug)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const renderedNotes = await Promise.all(
  relatedNotes.map(async (n) => {
    const { Content } = await render(n);
    return { id: n.id, data: n.data, Content };
  })
);

const statusLabels = {
  ongoing: "En desarrollo",
  finished: "Completado",
  archived: "Archivado",
};
---

<Layout title={data.title} description={data.description}>
  <article class="project-detail">
    <header class="project-header">
      <a href="/proyectos" class="back-link">← Volver a proyectos</a>
      <h1>{data.title}</h1>
      {data.subtitle && <p class="subtitle">{data.subtitle}</p>}
      <div class="meta">
        <span class="status status-{data.status}">{statusLabels[data.status]}</span>
        <span class="date">{data.date.toLocaleDateString("es-AR", { year: "numeric", month: "long" })}</span>
      </div>
    </header>

    <section class="case-study">
      {data.problem && (
        <div class="case-block">
          <span class="case-label">Problema</span>
          <p class="case-text">{data.problem}</p>
        </div>
      )}

      {data.challenge && (
        <div class="case-block challenge-block">
          <span class="case-label">Reto técnico</span>
          <p class="case-text">{data.challenge}</p>
        </div>
      )}

      {data.solution && (
        <div class="case-block">
          <span class="case-label">Solución</span>
          <p class="case-text">{data.solution}</p>
        </div>
      )}

      {data.highlights && data.highlights.length > 0 && (
        <div class="case-block highlights-block">
          <span class="case-label">Métricas destacadas</span>
          <div class="highlights-list">
            {data.highlights.map(h => <span class="highlight-badge">{h}</span>)}
          </div>
        </div>
      )}

      {data.result && (
        <div class="case-block highlight-block">
          <span class="case-label">Resultado</span>
          <p class="case-text result-text">{data.result}</p>
        </div>
      )}
    </section>

    {data.decisions && data.decisions.length > 0 && (
      <section class="decisions">
        <h2>Decisiones técnicas</h2>
        <ul>
          {data.decisions.map(d => <li>{d}</li>)}
        </ul>
      </section>
    )}

    <section class="tech-section">
      <h2>Stack tecnológico</h2>
      <div class="tech-tags">
        {data.tech.map(t => <span class="tag">{t}</span>)}
      </div>
    </section>

    {data.areas && data.areas.length > 0 && (
      <section class="areas-section">
        <h2>Áreas</h2>
        <div class="tech-tags">
          {data.areas.map(a => <span class="tag tag-area">{a}</span>)}
        </div>
      </section>
    )}

    {relatedNotes.length > 0 && (
      <section class="notes-section">
        <h2 class="notes-heading">
          Notas técnicas
          <span class="count-badge">{relatedNotes.length}</span>
        </h2>
        <div class="notes-list">
          {relatedNotes.map(n => (
            <a href={`#nota-${n.id}`} class="note-card">
              <div class="note-card-main">
                <time class="note-card-date" datetime={n.data.date.toISOString()}>
                  {n.data.date.toLocaleDateString("es-AR", { year: "numeric", month: "short" })}
                </time>
                <span class="note-card-title">{n.data.title}</span>
                <span class="note-card-desc">{n.data.description}</span>
                {n.data.tags && n.data.tags.length > 0 && (
                  <div class="note-card-tags">
                    {n.data.tags.slice(0, 3).map(t => <span class="note-tag">{t}</span>)}
                  </div>
                )}
              </div>
              <span class="note-card-arrow">→</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <div class="project-body">
      <slot />
    </div>

    <footer class="project-footer">
      {data.repo && data.repo !== "#" && (
        <a href={data.repo} class="btn" target="_blank" rel="noopener">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
          Ver repositorio
        </a>
      )}
      {data.live && data.live !== "#" && (
        <a href={data.live} class="btn btn-secondary" target="_blank" rel="noopener">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          Demo en vivo
        </a>
      )}
    </footer>
  </article>

  {renderedNotes.length > 0 && (
    <section class="notes-content">
      <h2 class="notes-content-heading">Notas técnicas</h2>
      {renderedNotes.map(n => (
        <article id={`nota-${n.id}`} class="note-full">
          <header class="note-full-header">
            <time class="note-full-date" datetime={n.data.date.toISOString()}>
              {n.data.date.toLocaleDateString("es-AR", { year: "numeric", month: "long" })}
            </time>
            <h3 class="note-full-title">{n.data.title}</h3>
            <p class="note-full-desc">{n.data.description}</p>
            {n.data.tags && n.data.tags.length > 0 && (
              <div class="note-full-tags">
                {n.data.tags.map(t => <span class="tag">{t}</span>)}
              </div>
            )}
          </header>
          <div class="note-full-body">
            <n.Content />
          </div>
        </article>
      ))}
    </section>
  )}
</Layout>

<style>
  .project-detail {
    padding: 48px 0 80px;
    max-width: 720px;
  }

  .back-link {
    font-size: 0.85rem;
    color: var(--text-secondary);
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-bottom: 32px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--accent-soft);
  }

  .project-header h1 {
    margin-bottom: 8px;
  }

  .subtitle {
    font-size: 1.1rem;
    color: var(--text-secondary);
    margin-bottom: 16px;
  }

  .meta {
    display: flex;
    gap: 16px;
    align-items: center;
    margin-bottom: 48px;
  }

  .status {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 4px 8px;
    border: 1px solid;
    border-radius: 4px;
    font-weight: 500;
  }

  .status-ongoing { border-color: rgba(234, 179, 8, 0.3); color: #EAB308; }
  .status-finished { border-color: rgba(74, 222, 128, 0.3); color: #4ADE80; }
  .status-archived { border-color: rgba(107, 114, 128, 0.3); color: #9CA3AF; }

  .date {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .case-study {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-bottom: 48px;
  }

  .case-block {
    padding: 20px;
    background: var(--bg-surface);
    border-radius: 10px;
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .highlight-block {
    border-color: var(--accent-glow);
    background: rgba(124, 58, 237, 0.05);
  }

  .challenge-block {
    border-color: rgba(234, 179, 8, 0.2);
    background: rgba(234, 179, 8, 0.03);
  }

  .highlights-block {
    border-color: rgba(124, 58, 237, 0.2);
  }

  .highlights-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .highlight-badge {
    background: rgba(124, 58, 237, 0.1);
    border: 1px solid rgba(124, 58, 237, 0.25);
    color: var(--accent-soft);
    font-size: 0.85rem;
    padding: 6px 14px;
    border-radius: 6px;
    font-weight: 600;
  }

  .case-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-soft);
    font-weight: 600;
  }

  .case-text {
    color: var(--text-secondary);
    line-height: 1.7;
    font-size: 0.95rem;
  }

  .result-text {
    color: var(--text-primary) !important;
    font-weight: 500;
  }

  .decisions {
    margin-bottom: 48px;
  }

  .decisions h2 {
    margin-bottom: 20px;
    font-size: 1.25rem;
  }

  .decisions ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .decisions li {
    padding-left: 20px;
    position: relative;
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .decisions li::before {
    content: "◆";
    position: absolute;
    left: 0;
    color: var(--accent);
    font-size: 0.6rem;
    top: 4px;
  }

  .tech-section, .areas-section {
    margin-bottom: 48px;
  }

  .tech-section h2, .areas-section h2 {
    margin-bottom: 16px;
    font-size: 1.25rem;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tag {
    background: var(--accent-glow);
    color: var(--accent-soft);
    font-size: 0.8rem;
    padding: 6px 12px;
    border-radius: 6px;
    font-weight: 500;
  }

  .tag-area {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-secondary);
  }

  .notes-section {
    margin-bottom: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }

  .notes-heading {
    font-size: 1.25rem;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .count-badge {
    font-size: 0.7rem;
    font-weight: 600;
    background: var(--accent-glow);
    color: var(--accent-soft);
    padding: 2px 9px;
    border-radius: 10px;
    line-height: 1.6;
  }

  .notes-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .note-card {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 18px 20px;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.25s, box-shadow 0.25s, background 0.25s;
    position: relative;
  }

  .note-card:hover {
    border-color: var(--border-hover);
    box-shadow: 0 0 0 1px rgba(139, 92, 246, 0.08);
    background: var(--bg-surface-hover);
  }

  /* left accent bar */
  .note-card::before {
    content: "";
    position: absolute;
    left: 0;
    top: 12px;
    bottom: 12px;
    width: 3px;
    background: transparent;
    border-radius: 0 2px 2px 0;
    transition: background 0.25s;
  }

  .note-card:hover::before {
    background: var(--accent);
  }

  .note-card-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
  }

  .note-card-date {
    font-size: 0.7rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 500;
  }

  .note-card-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent-soft);
    transition: color 0.2s;
    line-height: 1.4;
  }

  .note-card:hover .note-card-title {
    color: var(--accent);
  }

  .note-card-desc {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .note-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-top: 2px;
  }

  .note-tag {
    font-size: 0.65rem;
    padding: 2px 8px;
    background: var(--accent-glow);
    color: var(--accent-soft);
    border-radius: 4px;
    font-weight: 500;
  }

  .note-card-arrow {
    font-size: 1rem;
    color: var(--text-secondary);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.25s, transform 0.25s, color 0.25s;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .note-card:hover .note-card-arrow {
    opacity: 1;
    transform: translateX(0);
    color: var(--accent-soft);
  }

  .project-body {
    margin-bottom: 48px;
  }

  .project-body :global(h2) {
    margin-top: 32px;
    margin-bottom: 16px;
  }

  .project-body :global(p) {
    margin-bottom: 16px;
    line-height: 1.7;
  }

  .project-body :global(ul), .project-body :global(ol) {
    margin-bottom: 16px;
    padding-left: 24px;
  }

  .project-body :global(li) {
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 4px;
  }

  .project-footer {
    display: flex;
    gap: 12px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  .btn {
    padding: 12px 24px;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    transition: all 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .btn {
    background: var(--accent);
    color: white;
  }

  .btn:hover {
    background: #6D28D9;
    color: white;
  }

  .btn-secondary {
    background: var(--bg-surface);
    color: var(--text-primary);
    border: 1px solid var(--border);
  }

  .btn-secondary:hover {
    border-color: var(--accent);
    color: var(--accent-soft);
  }

  /* ── Notas expandidas inline ── */

  .notes-content {
    padding-top: 48px;
    border-top: 1px solid var(--border);
    margin-bottom: 64px;
    scroll-margin-top: 32px;
  }

  .notes-content-heading {
    font-size: 1.5rem;
    margin-bottom: 32px;
  }

  .note-full {
    margin-bottom: 48px;
    padding: 24px;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    scroll-margin-top: 48px;
  }

  .note-full:last-child {
    margin-bottom: 0;
  }

  .note-full-header {
    margin-bottom: 28px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--border);
  }

  .note-full-date {
    display: block;
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-bottom: 8px;
  }

  .note-full-title {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 8px;
    color: var(--text-primary);
  }

  .note-full-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 12px;
    max-width: 600px;
  }

  .note-full-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 4px;
  }

  .note-full-body {
    line-height: 1.75;
    font-size: 0.95rem;
    color: var(--text-secondary);
  }

  .note-full-body :global(h2) {
    font-size: 1.2rem;
    color: var(--text-primary);
    margin-top: 32px;
    margin-bottom: 14px;
  }

  .note-full-body :global(h3) {
    font-size: 1.05rem;
    color: var(--text-primary);
    margin-top: 24px;
    margin-bottom: 10px;
  }

  .note-full-body :global(p) {
    margin-bottom: 16px;
    line-height: 1.75;
  }

  .note-full-body :global(strong) {
    color: var(--text-primary);
  }

  .note-full-body :global(ul), .note-full-body :global(ol) {
    margin-bottom: 16px;
    padding-left: 24px;
  }

  .note-full-body :global(li) {
    margin-bottom: 6px;
    line-height: 1.7;
  }

  .note-full-body :global(code) {
    background: var(--bg-surface);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 0.85em;
  }

  .note-full-body :global(pre) {
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 16px 20px;
    overflow-x: auto;
    margin-bottom: 20px;
  }

  .note-full-body :global(pre code) {
    background: none;
    padding: 0;
  }

  .note-full-body :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding-left: 16px;
    margin-left: 0;
    margin-bottom: 16px;
    color: var(--text-secondary);
    font-style: italic;
  }

  .note-full-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
    font-size: 0.85rem;
  }

  .note-full-body :global(th) {
    text-align: left;
    padding: 8px 12px;
    border-bottom: 2px solid var(--border);
    color: var(--text-primary);
    font-weight: 600;
  }

  .note-full-body :global(td) {
    padding: 8px 12px;
    border-bottom: 1px solid var(--border);
  }

  .note-full-body :global(tr:last-child td) {
    border-bottom: none;
  }
</style>

---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import Icon from '../../components/Icon.astro';
import { CONTACT } from '../../components/SiteConfig';
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map(project => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;

const statusLabels = {
  ongoing: "En desarrollo",
  finished: "Entregado",
  archived: "Exploración",
} as const;

const originLabels: Record<string, string> = {
  client: "Trabajo para cliente",
  own: "Proyecto propio",
};

const statusLabel = statusLabels[data.status];
const originLabel = data.kind ? originLabels[data.kind] : "";
---

<Layout title={data.title} description={data.description}>
  <article class="project-detail">
    <header class="project-header">
      <a href="/proyectos" class="back-link">← Volver a proyectos</a>
      {data.brand && <p class="brand">{data.brand}</p>}
      <h1>{data.title}</h1>
      {data.subtitle && <p class="subtitle">{data.subtitle}</p>}
      <div class="meta">
        <span class="status status-{data.status}">{statusLabel}</span>
        {originLabel && (
          <span class="origin">{originLabel}{data.clientNote && ` · ${data.clientNote}`}</span>
        )}
        <span class="date">{data.date.toLocaleDateString("es-AR", { year: "numeric", month: "long" })}</span>
      </div>
      {data.role && (
        <p class="role"><span class="role-label">Rol</span>{data.role}</p>
      )}
    </header>

    {data.image && (
      <figure class="project-image">
        <Image src={data.image} alt={data.imageAlt ?? `Captura de ${data.title}`} loading="eager" />
      </figure>
    )}

    <section class="case-study">
      {data.problem && (
        <div class="case-block">
          <span class="case-label"><Icon name="target" class="case-icon" />Reto</span>
          <p class="case-text">{data.problem}</p>
        </div>
      )}

      {data.solution && (
        <div class="case-block">
          <span class="case-label"><Icon name="cube" class="case-icon" />Solución</span>
          <p class="case-text">{data.solution}</p>
        </div>
      )}
    </section>

    {(data.result || (data.highlights && data.highlights.length > 0)) && (
      <section class="result-section">
        <h2><Icon name="trending" class="heading-icon" />Resultado</h2>
        {data.result && <p class="case-text result-text">{data.result}</p>}
        {data.highlights && data.highlights.length > 0 && (
          <div class="highlights-list">
            {data.highlights.map(h => <span class="chip chip--data">{h}</span>)}
          </div>
        )}
      </section>
    )}

    {data.images && data.images.length > 0 && (
      <section class="gallery">
        <h2>Galería</h2>
        <div class="gallery-list">
          {data.images.map(img => (
            <figure class="gallery-item">
              <Image src={img.src} alt={img.alt} loading="lazy" />
              {img.caption && <figcaption>{img.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    )}

    <details class="technical">
      <summary>Detalle técnico (arquitectura, decisiones y stack)</summary>
      <div class="technical-body">
        {data.challenge && (
          <div class="case-block">
            <span class="case-label"><Icon name="sliders" class="case-icon" />Reto técnico</span>
            <p class="case-text">{data.challenge}</p>
          </div>
        )}

        <div class="project-body">
          <slot />
        </div>

        {data.decisions && data.decisions.length > 0 && (
          <section class="decisions">
            <h2>Decisiones técnicas</h2>
            <ul>
              {data.decisions.map(d => <li>{d}</li>)}
            </ul>
          </section>
        )}

        <section class="tech-section">
          <h2>Stack</h2>
          <div class="tech-tags">
            {data.tech.map(t => <span class="chip chip--tech">{t}</span>)}
          </div>
        </section>
      </div>
    </details>

    <footer class="project-footer">
      {data.repo && data.repo !== "#" && (
        <a href={data.repo} class="btn btn-secondary" target="_blank" rel="noopener">Ver repositorio</a>
      )}
      {data.live && data.live !== "#" && (
        <a href={data.live} class="btn btn-secondary" target="_blank" rel="noopener">Demo en vivo</a>
      )}
      <a href={`mailto:${CONTACT.email}`} class="btn btn-primary">¿Un problema similar? Escribime</a>
    </footer>
  </article>
</Layout>

<style>
  .project-detail {
    max-width: 760px;
    margin: 0 auto;
    padding: 48px 0 80px;
  }

  .back-link {
    font-size: var(--text-ui);
    color: var(--color-secondary);
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-bottom: 32px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .brand {
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    color: var(--color-accent);
    margin-bottom: 8px;
  }

  .project-header h1 {
    margin-bottom: 8px;
  }

  .subtitle {
    font-size: var(--text-lead);
    color: var(--color-secondary);
    margin-bottom: 16px;
  }

  .meta {
    display: flex;
    gap: 16px;
    align-items: center;
    margin-bottom: 20px;
  }

  .status {
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 4px 8px;
    border: 1px solid;
    border-radius: 4px;
    font-weight: 500;
  }

  .status-ongoing { border-color: rgba(202, 138, 4, 0.35); color: #A16207; }
  .status-finished { border-color: rgba(15, 118, 110, 0.3); color: var(--color-accent); }
  .status-archived { border-color: var(--color-border); color: var(--color-muted); }

  .role {
    font-size: var(--text-ui);
    color: var(--color-secondary);
    padding: 12px 16px;
    background: var(--color-surface);
    border-radius: 8px;
    border: 1px solid var(--color-border);
  }

  .role-label {
    display: inline-block;
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    color: var(--color-accent);
    margin-right: 10px;
  }

  .date {
    font-size: var(--text-ui);
    color: var(--color-muted);
  }

  .origin {
    font-size: var(--text-meta);
    color: var(--color-secondary);
  }

  .technical {
    margin: 40px 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .technical summary {
    list-style: none;
    cursor: pointer;
    padding: 20px 0;
    font-size: var(--text-ui);
    font-weight: 600;
    color: var(--color-accent);
  }

  .technical summary::-webkit-details-marker {
    display: none;
  }

  .technical summary::after {
    content: "+";
    float: right;
    font-weight: 400;
  }

  .technical[open] summary::after {
    content: "–";
  }

  .technical summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .technical-body {
    padding-bottom: 32px;
  }

  .project-image {
    margin: 0 0 48px;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .project-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  .case-study {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 40px;
  }

  .case-block {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-left: 20px;
    border-left: 2px solid var(--color-border);
  }

  .case-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    font-weight: 700;
  }

  .case-icon {
    font-size: 0.9rem;
  }

  .heading-icon {
    font-size: 1.1rem;
  }

  .case-text {
    color: var(--color-secondary);
    line-height: 1.75;
    font-size: var(--text-base);
  }

  .project-body :global(h2) {
    margin: 32px 0 16px;
    font-size: var(--text-title);
  }

  .project-body :global(p) {
    margin-bottom: 16px;
    line-height: 1.75;
  }

  .project-body :global(ul) {
    margin-bottom: 16px;
    padding-left: 20px;
  }

  .project-body :global(li) {
    color: var(--color-secondary);
    line-height: 1.6;
    margin-bottom: 6px;
  }

  .decisions {
    margin: 40px 0;
    padding-top: 32px;
    border-top: 1px solid var(--color-border);
  }

  .decisions h2 {
    margin-bottom: 20px;
    font-size: var(--text-title);
  }

  .decisions ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .decisions li {
    padding-left: 22px;
    position: relative;
    color: var(--color-secondary);
    font-size: var(--text-base);
    line-height: 1.65;
  }

  .decisions li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--color-accent);
  }

  .result-section {
    margin: 40px 0;
    padding: 24px;
    background: var(--color-accent-tint);
    border-radius: 12px;
  }

  .result-section h2 {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    font-size: var(--text-title);
  }

  .result-text {
    color: var(--color-primary);
    line-height: 1.75;
    font-size: var(--text-base);
  }

  .highlights-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }

  .result-section .chip--data {
    background: var(--color-background);
    border-color: var(--color-border);
    font-size: var(--text-ui);
  }

  .gallery {
    margin: 40px 0;
    padding-top: 32px;
    border-top: 1px solid var(--color-border);
  }

  .gallery h2 {
    margin-bottom: 20px;
    font-size: var(--text-title);
  }

  .gallery-list {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .gallery-item {
    margin: 0;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    overflow: hidden;
    background: var(--color-surface);
  }

  .gallery-item img {
    width: 100%;
    height: auto;
    display: block;
  }

  .gallery-item figcaption {
    font-size: var(--text-ui);
    line-height: 1.55;
    color: var(--color-secondary);
    padding: 12px 16px;
    border-top: 1px solid var(--color-border);
  }

  .tech-section {
    margin: 40px 0;
    padding-top: 32px;
    border-top: 1px solid var(--color-border);
  }

  .tech-section h2 {
    margin-bottom: 16px;
    font-size: var(--text-title);
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .project-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
  }
</style>

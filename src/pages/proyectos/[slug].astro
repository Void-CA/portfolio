---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map(project => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data, id: slug } = project;

// Notas técnicas asociadas a este proyecto
const allNotes = await getCollection("notes");
const relatedNotes = allNotes
  .filter(n => n.data.published && n.data.project === slug)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const statusLabels = {
  ongoing: "En desarrollo",
  finished: "Completado",
  archived: "Archivado",
};
---

<Layout title={data.title} description={data.description}>
  <div class="layout-wrapper">
    <article class="project-detail">
      <header class="project-header">
        <a href="/proyectos" class="back-link">← Volver a proyectos</a>
        <h1>{data.title}</h1>
        {data.subtitle && <p class="subtitle">{data.subtitle}</p>}
        <div class="meta">
          <span class="status status-{data.status}">{statusLabels[data.status]}</span>
          <span class="date">{data.date.toLocaleDateString("es-AR", { year: "numeric", month: "long" })}</span>
        </div>
      </header>

      <!--
        Imagen de portada del proyecto.
        Uso: data.image ? `<img src=${data.image} ...>` : null
        Tipos sugeridos: terminal elegante, diagrama de arquitectura,
        visualización de datos, render del sistema, screenshot curado.
      -->
      {data.image && (
        <div class="project-image">
          <img src={data.image} alt={`Portada de ${data.title}`} loading="lazy" />
        </div>
      )}

      <section class="case-study">
        {data.problem && (
          <div class="case-block">
            <span class="case-label">Problema</span>
            <p class="case-text">{data.problem}</p>
          </div>
        )}

        {data.challenge && (
          <div class="case-block challenge-block">
            <span class="case-label">Reto técnico</span>
            <p class="case-text">{data.challenge}</p>
          </div>
        )}

        {data.solution && (
          <div class="case-block">
            <span class="case-label">Solución</span>
            <p class="case-text">{data.solution}</p>
          </div>
        )}

        {data.highlights && data.highlights.length > 0 && (
          <div class="case-block highlights-block">
            <span class="case-label">Métricas destacadas</span>
            <div class="highlights-list">
              {data.highlights.map(h => <span class="highlight-badge">{h}</span>)}
            </div>
          </div>
        )}

        {data.result && (
          <div class="case-block highlight-block">
            <span class="case-label">Resultado</span>
            <p class="case-text result-text">{data.result}</p>
          </div>
        )}
      </section>

      {data.decisions && data.decisions.length > 0 && (
        <section class="decisions">
          <h2>Decisiones técnicas</h2>
          <ul>
            {data.decisions.map(d => <li>{d}</li>)}
          </ul>
        </section>
      )}

      <section class="tech-section">
        <h2>Stack tecnológico</h2>
        <div class="tech-tags">
          {data.tech.map(t => <span class="tag">{t}</span>)}
        </div>
      </section>

      {data.areas && data.areas.length > 0 && (
        <section class="areas-section">
          <h2>Áreas</h2>
          <div class="tech-tags">
            {data.areas.map(a => <span class="tag tag-area">{a}</span>)}
          </div>
        </section>
      )}

      <div class="project-body">
        <slot />
      </div>

      <footer class="project-footer">
        {data.repo && data.repo !== "#" && (
          <a href={data.repo} class="btn" target="_blank" rel="noopener">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
            Ver repositorio
          </a>
        )}
        {data.live && data.live !== "#" && (
          <a href={data.live} class="btn btn-secondary" target="_blank" rel="noopener">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            Demo en vivo
          </a>
        )}
      </footer>
    </article>

    {relatedNotes.length > 0 && (
      <aside class="notes-sidebar">
        <h2 class="sidebar-heading">
          Notas técnicas
          <span class="count-badge">{relatedNotes.length}</span>
        </h2>
        <nav class="sidebar-list">
          {relatedNotes.map(n => (
            <a href={`/notas/${n.id}`} class="sidebar-link">
              <span class="sidebar-indicator" aria-hidden="true">◆</span>
              <span class="sidebar-title">{n.data.title}</span>
              <span class="sidebar-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </nav>
      </aside>
    )}
  </div>
</Layout>

<style>
  .layout-wrapper {
    display: flex;
    gap: 48px;
    align-items: flex-start;
    padding: 48px 0 80px;
  }

  .project-detail {
    flex: 1;
    max-width: 720px;
  }

  .notes-sidebar {
    width: 220px;
    flex-shrink: 0;
    position: sticky;
    top: 48px;
    padding: 0 0 0 20px;
    border-left: 1px solid var(--border);
  }

  /* glow sutil en el borde izquierdo */
  .notes-sidebar::before {
    content: "";
    position: absolute;
    left: -1px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(
      180deg,
      transparent 0%,
      var(--accent-glow) 20%,
      var(--accent-glow) 60%,
      transparent 100%
    );
    opacity: 0.4;
    pointer-events: none;
  }

  .sidebar-heading {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding-top: 2px;
  }

  .sidebar-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .sidebar-link {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 12px 14px;
    border-radius: 8px;
    font-size: 0.82rem;
    line-height: 1.45;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: background 0.25s, color 0.25s;
    position: relative;
  }

  .sidebar-link:hover {
    background: var(--accent-glow);
    color: var(--text-primary);
  }

  /* indicador ◆ (coherente con lista de decisiones) */
  .sidebar-indicator {
    font-size: 0.4rem;
    color: var(--border-hover);
    flex-shrink: 0;
    margin-top: 6px;
    transition: color 0.25s, transform 0.25s;
  }

  .sidebar-link:hover .sidebar-indicator {
    color: var(--accent);
    transform: scale(1.3);
  }

  .sidebar-title {
    flex: 1;
    min-width: 0;
  }

  /* flecha que aparece al hover */
  .sidebar-arrow {
    font-size: 0.75rem;
    color: var(--accent-soft);
    flex-shrink: 0;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.25s, transform 0.25s;
    margin-top: 2px;
  }

  .sidebar-link:hover .sidebar-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 1023px) {
    .layout-wrapper {
      flex-direction: column;
      gap: 32px;
    }

    .notes-sidebar {
      width: 100%;
      position: static;
      padding: 20px 0 0;
      border-left: none;
      border-top: 1px solid var(--border);
    }

    .notes-sidebar::before {
      display: none;
    }

    .sidebar-heading {
      margin-bottom: 14px;
    }

    .sidebar-list {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 8px;
    }

    .sidebar-link {
      padding: 10px 16px;
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      gap: 8px;
    }

    .sidebar-indicator {
      margin-top: 5px;
    }
  }

  .back-link {
    font-size: 0.85rem;
    color: var(--text-secondary);
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-bottom: 32px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--accent-soft);
  }

  .project-header h1 {
    margin-bottom: 8px;
  }

  .project-image {
    margin-bottom: 48px;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-surface);
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .subtitle {
    font-size: 1.1rem;
    color: var(--text-secondary);
    margin-bottom: 16px;
  }

  .meta {
    display: flex;
    gap: 16px;
    align-items: center;
    margin-bottom: 48px;
  }

  .status {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 4px 8px;
    border: 1px solid;
    border-radius: 4px;
    font-weight: 500;
  }

  .status-ongoing { border-color: rgba(234, 179, 8, 0.3); color: #EAB308; }
  .status-finished { border-color: rgba(74, 222, 128, 0.3); color: #4ADE80; }
  .status-archived { border-color: rgba(107, 114, 128, 0.3); color: #9CA3AF; }

  .date {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .case-study {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-bottom: 48px;
  }

  .case-block {
    padding: 20px;
    background: var(--bg-surface);
    border-radius: 10px;
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .highlight-block {
    border-color: var(--accent-glow);
    background: rgba(124, 58, 237, 0.05);
  }

  .challenge-block {
    border-color: rgba(234, 179, 8, 0.2);
    background: rgba(234, 179, 8, 0.03);
  }

  .highlights-block {
    border-color: rgba(124, 58, 237, 0.2);
  }

  .highlights-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .highlight-badge {
    background: rgba(124, 58, 237, 0.1);
    border: 1px solid rgba(124, 58, 237, 0.25);
    color: var(--accent-soft);
    font-size: 0.85rem;
    padding: 6px 14px;
    border-radius: 6px;
    font-weight: 600;
  }

  .case-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-soft);
    font-weight: 600;
  }

  .case-text {
    color: var(--text-secondary);
    line-height: 1.7;
    font-size: 0.95rem;
  }

  .result-text {
    color: var(--text-primary) !important;
    font-weight: 500;
  }

  .decisions {
    margin-bottom: 48px;
  }

  .decisions h2 {
    margin-bottom: 20px;
    font-size: 1.25rem;
  }

  .decisions ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .decisions li {
    padding-left: 20px;
    position: relative;
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .decisions li::before {
    content: "◆";
    position: absolute;
    left: 0;
    color: var(--accent);
    font-size: 0.6rem;
    top: 4px;
  }

  .tech-section, .areas-section {
    margin-bottom: 48px;
  }

  .tech-section h2, .areas-section h2 {
    margin-bottom: 16px;
    font-size: 1.25rem;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tag {
    background: var(--accent-glow);
    color: var(--accent-soft);
    font-size: 0.8rem;
    padding: 6px 12px;
    border-radius: 6px;
    font-weight: 500;
  }

  .tag-area {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-secondary);
  }

  .count-badge {
    font-size: 0.7rem;
    font-weight: 600;
    background: var(--accent-glow);
    color: var(--accent-soft);
    padding: 2px 9px;
    border-radius: 10px;
    line-height: 1.6;
  }

  .project-body {
    margin-bottom: 48px;
  }

  .project-body :global(h2) {
    margin-top: 32px;
    margin-bottom: 16px;
  }

  .project-body :global(p) {
    margin-bottom: 16px;
    line-height: 1.7;
  }

  .project-body :global(ul), .project-body :global(ol) {
    margin-bottom: 16px;
    padding-left: 24px;
  }

  .project-body :global(li) {
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 4px;
  }

  .project-footer {
    display: flex;
    gap: 12px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  .btn {
    padding: 12px 24px;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    transition: all 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .btn {
    background: var(--accent);
    color: white;
  }

  .btn:hover {
    background: #6D28D9;
    color: white;
  }

  .btn-secondary {
    background: var(--bg-surface);
    color: var(--text-primary);
    border: 1px solid var(--border);
  }

  .btn-secondary:hover {
    border-color: var(--accent);
    color: var(--accent-soft);
  }

</style>

---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import Icon from '../../components/Icon.astro';
import Gallery from '../../components/Gallery.astro';
import { CONTACT } from '../../components/SiteConfig';
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map(project => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const statusLabels = {
  ongoing: "En desarrollo",
  finished: "Entregado",
  archived: "Exploración",
} as const;

const originLabels: Record<string, string> = {
  client: "Trabajo para cliente",
  own: "Proyecto propio",
};

const statusLabel = statusLabels[data.status];
const originLabel = data.kind ? originLabels[data.kind] : "";

const images = data.images ?? [];
const metrics = data.metrics ?? [];
const highlights = data.highlights ?? [];
const decisions = data.decisions ?? [];
const heroTech = data.tech.slice(0, 4);

const hasPreview = Boolean(data.image);
const hasMetrics = metrics.length > 0;
const hasEvidence = hasMetrics || Boolean(data.result) || highlights.length > 0;
const hasDecisions = decisions.length > 0;
---

<Layout title={data.title} description={data.description}>
  <article class="project-detail">
    <a href="/proyectos" class="back-link">← Volver a proyectos</a>

    <header class:list={["project-hero", hasPreview && "project-hero--split"]}>
      <div class="hero-copy">
        {data.brand && <p class="brand">{data.brand}</p>}
        <h1>{data.title}</h1>
        {data.subtitle && <p class="subtitle">{data.subtitle}</p>}

        <div class="meta">
          <span class={`status status-${data.status}`}>{statusLabel}</span>
          {originLabel && (
            <span class="origin">{originLabel}{data.clientNote && ` · ${data.clientNote}`}</span>
          )}
          <span class="date">{data.date.toLocaleDateString("es-AR", { year: "numeric", month: "long" })}</span>
        </div>

        {data.role && (
          <p class="role"><span class="role-label">Rol</span>{data.role}</p>
        )}

        {data.problem && (
          <div class="case-block">
            <span class="case-label"><Icon name="target" class="case-icon" />Reto</span>
            <p class="case-text">{data.problem}</p>
          </div>
        )}

        {data.solution && (
          <div class="case-block">
            <span class="case-label"><Icon name="cube" class="case-icon" />Solución</span>
            <p class="case-text">{data.solution}</p>
          </div>
        )}

        {heroTech.length > 0 && (
          <div class="hero-tech">
            {heroTech.map(t => <span class="chip chip--tech">{t}</span>)}
          </div>
        )}
      </div>

      {hasPreview && (
        <figure class="hero-preview">
          <Image
            src={data.image!}
            alt={data.imageAlt ?? `Captura de ${data.title}`}
            loading="eager"
          />
        </figure>
      )}
    </header>

    {hasEvidence && (
      <section class="evidence">
        <span class="evidence-label"><Icon name="trending" class="heading-icon" />Resultado</span>

        {hasMetrics && (
          <div class="evidence-metrics">
            {metrics.map(m => (
              <div class="metric">
                <div class="metric-head">
                  {m.from && <span class="metric-from">{m.from}</span>}
                  {m.from && <span class="metric-arrow">→</span>}
                  <span class="metric-value">{m.value}</span>
                </div>
                <span class="metric-label">{m.label}</span>
              </div>
            ))}
          </div>
        )}

        {data.result && <p class="evidence-result">{data.result}</p>}

        {highlights.length > 0 && (
          <div class="highlights-list">
            {highlights.map(h => <span class="chip chip--data">{h}</span>)}
          </div>
        )}
      </section>
    )}

    <Gallery images={images} />

    <details class="technical">
      <summary>Detalle técnico (arquitectura, decisiones y stack)</summary>
      <div class="technical-body">
        {data.architecture && (
          <div class="case-block">
            <span class="case-label"><Icon name="layers" class="case-icon" />Arquitectura</span>
            <p class="case-text">{data.architecture}</p>
          </div>
        )}

        {data.challenge && (
          <div class="case-block">
            <span class="case-label"><Icon name="sliders" class="case-icon" />Reto técnico</span>
            <p class="case-text">{data.challenge}</p>
          </div>
        )}

        <div class="project-body">
          <Content />
        </div>

        {hasDecisions && (
          <section class="decisions">
            <h2>Decisiones técnicas</h2>
            <div class="decision-grid">
              {decisions.map(d =>
                typeof d === "string"
                  ? <p class="decision-plain">{d}</p>
                  : (
                    <div class="decision">
                      <span class="decision-label">{d.label}</span>
                      <span class="decision-detail">{d.detail}</span>
                    </div>
                  )
              )}
            </div>
          </section>
        )}

        <section class="tech-section">
          <h2>Stack</h2>
          <div class="tech-tags">
            {data.tech.map(t => <span class="chip chip--tech">{t}</span>)}
          </div>
        </section>
      </div>
    </details>

    <footer class="project-footer">
      {data.repo && data.repo !== "#" && (
        <a href={data.repo} class="btn btn-secondary" target="_blank" rel="noopener">Ver repositorio</a>
      )}
      {data.live && data.live !== "#" && (
        <a href={data.live} class="btn btn-secondary" target="_blank" rel="noopener">Demo en vivo</a>
      )}
      <a href={`mailto:${CONTACT.email}`} class="btn btn-primary">¿Un problema similar? Escribime</a>
    </footer>
  </article>
</Layout>

<style>
  .project-detail {
    padding: 48px 0 80px;
  }

  .back-link {
    font-size: var(--text-ui);
    color: var(--color-secondary);
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-bottom: 32px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  /* ── Hero ── */
  .project-hero {
    display: grid;
    gap: 40px;
    margin-bottom: 48px;
  }

  .project-hero--split {
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: start;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 68ch;
  }

  .brand {
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    color: var(--color-accent);
    margin-bottom: -12px;
  }

  .hero-copy h1 {
    margin: 0;
  }

  .subtitle {
    font-size: var(--text-lead);
    color: var(--color-secondary);
    margin-top: -12px;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
  }

  .status {
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 4px 8px;
    border: 1px solid;
    border-radius: 4px;
    font-weight: 500;
  }

  .status-ongoing { border-color: rgba(202, 138, 4, 0.35); color: #A16207; }
  .status-finished { border-color: rgba(15, 118, 110, 0.3); color: var(--color-accent); }
  .status-archived { border-color: var(--color-border); color: var(--color-muted); }

  .origin {
    font-size: var(--text-meta);
    color: var(--color-secondary);
  }

  .date {
    font-size: var(--text-ui);
    color: var(--color-muted);
  }

  .role {
    font-size: var(--text-ui);
    color: var(--color-secondary);
    padding: 12px 16px;
    background: var(--color-surface);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
  }

  .role-label {
    display: inline-block;
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    color: var(--color-accent);
    margin-right: 10px;
  }

  .hero-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .hero-preview {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  .hero-preview img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* ── Bloques de caso (Reto / Solución / Arquitectura) ── */
  .case-block {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-left: 20px;
    border-left: 2px solid var(--color-border);
  }

  .case-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    font-weight: 700;
  }

  .case-icon {
    font-size: 0.9rem;
  }

  .heading-icon {
    font-size: 1rem;
  }

  .case-text {
    color: var(--color-secondary);
    line-height: 1.75;
    font-size: var(--text-base);
  }

  /* ── Evidencia ── */
  .evidence {
    margin: 0 0 48px;
    padding: 28px 32px;
    background: var(--color-accent-tint);
    border-radius: var(--radius-lg);
  }

  .evidence-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    color: var(--color-accent);
    margin-bottom: 20px;
  }

  .evidence-metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    margin-bottom: 24px;
  }

  .metric {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .metric-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .metric-from {
    font-size: var(--text-lead);
    color: var(--color-secondary);
  }

  .metric-arrow {
    font-size: var(--text-lead);
    color: var(--color-accent);
  }

  .metric-value {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--color-accent-strong);
  }

  .metric-label {
    font-size: var(--text-ui);
    color: var(--color-secondary);
  }

  .evidence-result {
    color: var(--color-primary);
    line-height: 1.75;
    font-size: var(--text-base);
    max-width: 72ch;
  }

  .highlights-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }

  .evidence .chip--data {
    background: var(--color-background);
    border-color: var(--color-border);
    font-size: var(--text-ui);
  }

  /* ── Detalle técnico ── */
  .technical {
    margin: 0 0 40px;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .technical summary {
    list-style: none;
    cursor: pointer;
    padding: 20px 0;
    font-size: var(--text-ui);
    font-weight: 600;
    color: var(--color-accent);
  }

  .technical summary::-webkit-details-marker {
    display: none;
  }

  .technical summary::after {
    content: "+";
    float: right;
    font-weight: 400;
  }

  .technical[open] summary::after {
    content: "–";
  }

  .technical summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .technical-body {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-bottom: 32px;
  }

  .technical-body .case-text,
  .project-body :global(p) {
    max-width: 76ch;
  }

  .project-body :global(h2) {
    margin: 8px 0 12px;
    font-size: var(--text-title);
  }

  .project-body :global(p) {
    margin-bottom: 16px;
    line-height: 1.75;
  }

  .project-body :global(ul) {
    margin-bottom: 16px;
    padding-left: 20px;
  }

  .project-body :global(li) {
    color: var(--color-secondary);
    line-height: 1.6;
    margin-bottom: 6px;
  }

  .project-body :global(pre) {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 16px;
    overflow-x: auto;
    margin-bottom: 16px;
    font-size: var(--text-meta);
  }

  .project-body :global(code) {
    font-family: var(--font-mono);
  }

  /* ── Decisiones ── */
  .decisions h2 {
    margin-bottom: 16px;
    font-size: var(--text-title);
  }

  .decision-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 12px;
  }

  .decision {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 16px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .decision-label {
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 700;
    color: var(--color-accent);
  }

  .decision-detail {
    font-size: var(--text-base);
    line-height: 1.55;
    color: var(--color-secondary);
  }

  .decision-plain {
    grid-column: 1 / -1;
    padding-left: 22px;
    position: relative;
    color: var(--color-secondary);
    font-size: var(--text-base);
    line-height: 1.65;
  }

  .decision-plain::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--color-accent);
  }

  /* ── Stack ── */
  .tech-section h2 {
    margin-bottom: 16px;
    font-size: var(--text-title);
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  /* ── Footer ── */
  .project-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
  }

  @media (max-width: 1023.98px) {
    .project-hero--split {
      grid-template-columns: 1fr;
    }

    .hero-preview {
      order: -1;
    }
  }

  @media (max-width: 767.98px) {
    .project-detail {
      padding: 32px 0 64px;
    }

    .evidence {
      padding: 20px;
    }

    .evidence-metrics {
      gap: 24px;
    }
  }
</style>

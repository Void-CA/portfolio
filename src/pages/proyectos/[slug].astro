---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { CONTACT } from '../../components/SiteConfig';
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map(project => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;

const statusLabels = {
  ongoing: "En desarrollo",
  finished: "Completado",
  archived: "Archivado",
};
---

<Layout title={data.title} description={data.description}>
  <article class="project-detail">
    <header class="project-header">
      <a href="/proyectos" class="back-link">← Volver a proyectos</a>
      {data.brand && <p class="brand">{data.brand}</p>}
      <h1>{data.title}</h1>
      {data.subtitle && <p class="subtitle">{data.subtitle}</p>}
      <div class="meta">
        <span class="status status-{data.status}">{statusLabels[data.status]}</span>
        <span class="date">{data.date.toLocaleDateString("es-AR", { year: "numeric", month: "long" })}</span>
      </div>
      {data.role && (
        <p class="role"><span class="role-label">Rol</span>{data.role}</p>
      )}
    </header>

    <figure class="project-image">
      {data.image
        ? <Image src={data.image} alt={`Captura de ${data.title}`} loading="eager" />
        : <img src="/test.png" alt="" />}
    </figure>

    <section class="case-study">
      {data.problem && (
        <div class="case-block">
          <span class="case-label">Reto</span>
          <p class="case-text">{data.problem}</p>
        </div>
      )}

      {data.challenge && (
        <div class="case-block">
          <span class="case-label">Reto técnico</span>
          <p class="case-text">{data.challenge}</p>
        </div>
      )}

      {data.solution && (
        <div class="case-block">
          <span class="case-label">Solución</span>
          <p class="case-text">{data.solution}</p>
        </div>
      )}
    </section>

    <div class="project-body">
      <slot />
    </div>

    {data.decisions && data.decisions.length > 0 && (
      <section class="decisions">
        <h2>Decisiones técnicas</h2>
        <ul>
          {data.decisions.map(d => <li>{d}</li>)}
        </ul>
      </section>
    )}

    {(data.result || (data.highlights && data.highlights.length > 0)) && (
      <section class="result-section">
        <h2>Resultado</h2>
        {data.result && <p class="case-text result-text">{data.result}</p>}
        {data.highlights && data.highlights.length > 0 && (
          <div class="highlights-list">
            {data.highlights.map(h => <span class="highlight-badge">{h}</span>)}
          </div>
        )}
      </section>
    )}

    {data.images && data.images.length > 0 && (
      <section class="gallery">
        <h2>Galería</h2>
        <div class="gallery-list">
          {data.images.map(img => (
            <figure class="gallery-item">
              <Image src={img.src} alt={img.alt} loading="lazy" />
              {img.caption && <figcaption>{img.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    )}

    <section class="tech-section">
      <h2>Stack</h2>
      <div class="tech-tags">
        {data.tech.map(t => <span class="tag">{t}</span>)}
      </div>
    </section>

    <footer class="project-footer">
      {data.repo && data.repo !== "#" && (
        <a href={data.repo} class="btn btn-secondary" target="_blank" rel="noopener">Ver repositorio</a>
      )}
      {data.live && data.live !== "#" && (
        <a href={data.live} class="btn btn-secondary" target="_blank" rel="noopener">Demo en vivo</a>
      )}
      <a href={`mailto:${CONTACT.email}`} class="btn">¿Un problema similar? Escribime</a>
    </footer>
  </article>
</Layout>

<style>
  .project-detail {
    max-width: 760px;
    margin: 0 auto;
    padding: 48px 0 80px;
  }

  .back-link {
    font-size: 0.85rem;
    color: var(--text-secondary);
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-bottom: 32px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .brand {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 8px;
  }

  .project-header h1 {
    margin-bottom: 8px;
  }

  .subtitle {
    font-size: 1.1rem;
    color: var(--text-secondary);
    margin-bottom: 16px;
  }

  .meta {
    display: flex;
    gap: 16px;
    align-items: center;
    margin-bottom: 20px;
  }

  .status {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 4px 8px;
    border: 1px solid;
    border-radius: 4px;
    font-weight: 500;
  }

  .status-ongoing { border-color: rgba(202, 138, 4, 0.35); color: #A16207; }
  .status-finished { border-color: rgba(15, 118, 110, 0.3); color: var(--accent); }
  .status-archived { border-color: var(--border); color: var(--text-muted); }

  .role {
    font-size: 0.85rem;
    color: var(--text-secondary);
    padding: 12px 16px;
    background: var(--bg-surface);
    border-radius: 8px;
    border: 1px solid var(--border);
  }

  .role-label {
    display: inline-block;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    color: var(--accent);
    margin-right: 10px;
  }

  .date {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .project-image {
    margin: 0 0 48px;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-surface);
  }

  .project-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  .case-study {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 40px;
  }

  .case-block {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-left: 20px;
    border-left: 2px solid var(--border);
  }

  .case-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    font-weight: 700;
  }

  .case-text {
    color: var(--text-secondary);
    line-height: 1.75;
    font-size: 0.95rem;
  }

  .project-body :global(h2) {
    margin: 32px 0 16px;
    font-size: 1.25rem;
  }

  .project-body :global(p) {
    margin-bottom: 16px;
    line-height: 1.75;
  }

  .project-body :global(ul) {
    margin-bottom: 16px;
    padding-left: 20px;
  }

  .project-body :global(li) {
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 6px;
  }

  .decisions {
    margin: 40px 0;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }

  .decisions h2 {
    margin-bottom: 20px;
    font-size: 1.25rem;
  }

  .decisions ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .decisions li {
    padding-left: 22px;
    position: relative;
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.65;
  }

  .decisions li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  .result-section {
    margin: 40px 0;
    padding: 24px;
    background: var(--accent-tint);
    border-radius: 12px;
  }

  .result-section h2 {
    margin-bottom: 16px;
    font-size: 1.25rem;
  }

  .result-text {
    color: var(--text-primary);
    line-height: 1.75;
    font-size: 0.95rem;
  }

  .highlights-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }

  .highlight-badge {
    background: var(--bg-primary);
    border: 1px solid var(--border);
    color: var(--accent);
    font-size: 0.82rem;
    padding: 6px 14px;
    border-radius: 6px;
    font-weight: 600;
  }

  .gallery {
    margin: 40px 0;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }

  .gallery h2 {
    margin-bottom: 20px;
    font-size: 1.25rem;
  }

  .gallery-list {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .gallery-item {
    margin: 0;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    background: var(--bg-surface);
  }

  .gallery-item img {
    width: 100%;
    height: auto;
    display: block;
  }

  .gallery-item figcaption {
    font-size: 0.82rem;
    line-height: 1.55;
    color: var(--text-secondary);
    padding: 12px 16px;
    border-top: 1px solid var(--border);
  }

  .tech-section {
    margin: 40px 0;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }

  .tech-section h2 {
    margin-bottom: 16px;
    font-size: 1.25rem;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tag {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    color: var(--text-secondary);
    font-size: 0.8rem;
    padding: 6px 12px;
    border-radius: 6px;
    font-weight: 500;
  }

  .project-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  .btn {
    padding: 12px 24px;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    transition: background-color 0.2s, border-color 0.2s, color 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--accent);
    color: #FFFFFF;
  }

  .btn:hover {
    background: var(--accent-bright);
    color: #FFFFFF;
  }

  .btn-secondary {
    background: var(--bg-primary);
    color: var(--text-primary);
    border: 1px solid var(--border);
  }

  .btn-secondary:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>

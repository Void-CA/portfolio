---
import { ICONS } from '../../data/icons';

interface Props {
  name: string;
  class?: string;
  label?: string;
}

const { name, label } = Astro.props;
const svg = ICONS[name];

const svgWithTitle = label
  ? svg.replace('>', ` role="img" aria-label="${label}">`)
  : svg.replace('<svg', '<svg aria-hidden="true"');
---

{svg && <span class:list={["inline-flex shrink-0 leading-none [&>svg]:block [&>svg]:h-[1em] [&>svg]:w-[1em]", Astro.props.class]} set:html={svgWithTitle} />}

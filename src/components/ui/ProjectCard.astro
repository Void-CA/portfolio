---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { data, id: slug } = project;

const statusLabels: Record<string, string> = {
  ongoing: "En desarrollo",
  finished: "Entregado",
  archived: "Exploración",
};

const originLabels: Record<string, string> = {
  client: "Trabajo para cliente",
  own: "Proyecto propio",
};

const statusLabel = statusLabels[data.status] || "";
const originLabel = data.kind ? originLabels[data.kind] : "";
---

<article class="group relative flex h-full flex-col gap-2.5 rounded-xl border border-border bg-background p-5 shadow-subtle transition-[border-color,box-shadow] duration-200 hover:border-border-hover hover:shadow-card max-md:p-4">
  {data.image && (
    <div class="-mx-5 -mt-5 mb-1 flex aspect-video items-center justify-center overflow-hidden rounded-t-xl bg-surface max-md:-mx-4 max-md:-mt-4">
      <Image src={data.image} alt="" loading="lazy" class="block h-full w-full object-cover" />
    </div>
  )}

  {data.brand && (
    <span class="text-micro font-bold uppercase tracking-[0.1em] text-accent">{data.brand}</span>
  )}

  <h3 class="text-lead font-semibold leading-tight tracking-[-0.01em] text-primary transition-colors group-hover:text-accent">
    <a href={`/proyectos/${slug}`} class="text-inherit no-underline after:absolute after:inset-0 after:rounded-xl">{data.title}</a>
  </h3>

  <p class="line-clamp-2 text-base leading-[1.55] text-secondary">{data.description}</p>

  {data.result && <p class="line-clamp-2 text-base leading-[1.55] text-primary">{data.result}</p>}

  <div class="mt-auto flex items-center justify-between gap-3 border-t border-border pt-2.5">
    <span class="flex min-w-0 items-center gap-1.5 text-micro font-semibold uppercase tracking-[0.05em] text-muted">
      {originLabel}
      {originLabel && statusLabel && <span class="opacity-50">·</span>}
      {statusLabel}
    </span>
    <span class="flex-shrink-0 text-ui text-accent transition-transform duration-200 group-hover:translate-x-[3px]">→</span>
  </div>
</article>

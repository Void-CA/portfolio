---
// Motivo de sistema: problema → sistema → resultado.
// Abstracto y decorativo (aria-hidden): no aporta información única.
const labelClass = "fill-muted font-mono text-[11px] uppercase tracking-[0.12em]";
---

<div class="w-full max-w-[260px]" aria-hidden="true">
  <svg viewBox="0 0 240 268" role="presentation" class="block h-auto w-full">
    <line class="stroke-border" x1="24" y1="30" x2="24" y2="238" stroke-width="2" />

    <circle class="fill-background stroke-border" cx="24" cy="30" r="6" stroke-width="2" />
    <circle class="fill-accent stroke-accent" cx="24" cy="134" r="7" stroke-width="2" />
    <circle class="fill-background stroke-border" cx="24" cy="238" r="6" stroke-width="2" />

    <text class={labelClass} x="48" y="35">Problema</text>
    <text class={`fill-accent font-mono text-[11px] font-semibold uppercase tracking-[0.12em]`} x="48" y="139">Sistema</text>
    <text class={labelClass} x="48" y="243">Resultado</text>
  </svg>
</div>

---
// Motivo de sistema: problema → sistema → resultado.
// Horizontal en escritorio; vertical apilado en pantallas angostas.
// Abstracto y decorativo (aria-hidden): no aporta información única.
const vLabelClass = "fill-muted font-mono text-[11px] uppercase tracking-[0.12em]";
const vAccentClass = "fill-accent font-mono text-[11px] font-semibold uppercase tracking-[0.12em]";
const hLabelClass = "fill-muted font-mono text-[13px] uppercase tracking-[0.14em]";
const hAccentClass = "fill-accent font-mono text-[13px] font-semibold uppercase tracking-[0.14em]";
---

<div aria-hidden="true">
  <!-- Vertical (móvil): el flujo se apila para conservar legibilidad. -->
  <svg viewBox="0 0 120 220" role="presentation" class="mx-auto block h-auto w-full md:hidden">
    <line class="stroke-border" x1="14" y1="24" x2="14" y2="196" stroke-width="2" />

    <circle class="fill-background stroke-border" cx="14" cy="24" r="6" stroke-width="2" />
    <circle class="fill-accent stroke-accent" cx="14" cy="110" r="7" stroke-width="2" />
    <circle class="fill-background stroke-border" cx="14" cy="196" r="6" stroke-width="2" />

    <text class={vLabelClass} text-anchor="start" x="30" y="28">Problema</text>
    <text class={vAccentClass} text-anchor="start" x="30" y="114">Sistema</text>
    <text class={vLabelClass} text-anchor="start" x="30" y="200">Resultado</text>
  </svg>

  <!-- Horizontal (escritorio): con más masa visual para acompañar el hero. -->
  <svg viewBox="0 0 340 100" role="presentation" class="hidden h-auto w-full md:block">
    <line class="stroke-border" x1="40" y1="34" x2="300" y2="34" stroke-width="2.5" />

    <circle class="fill-background stroke-border" cx="40" cy="34" r="8" stroke-width="2.5" />
    <circle class="fill-accent stroke-accent" cx="170" cy="34" r="9" stroke-width="2.5" />
    <circle class="fill-background stroke-border" cx="300" cy="34" r="8" stroke-width="2.5" />

    <text class={hLabelClass} text-anchor="middle" x="40" y="76">Problema</text>
    <text class={hAccentClass} text-anchor="middle" x="170" y="76">Sistema</text>
    <text class={hLabelClass} text-anchor="middle" x="300" y="76">Resultado</text>
  </svg>
</div>

---
import HeroDiagram from '../HeroDiagram.astro';
---

<section id="propuesta" class="flex flex-col gap-8 pt-12 pb-10 md:flex-row md:items-center md:gap-12 md:pt-20 md:pb-16">
  <div class="max-w-[620px] flex-1">
    <p class="mb-[18px] inline-flex items-center gap-2 text-ui font-medium text-secondary">
      <span class="size-2 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>Disponible para proyectos freelance
    </p>
    <h1>
      Software que se adapta a tu operación, <span class="text-accent">no al revés</span>.
    </h1>
    <p class="mt-4 max-w-[560px] text-lead leading-[1.7]">
      Desarrollo software para automatizar procesos, conectar información y
      resolver operaciones que las herramientas existentes no cubren.
    </p>
    <div class="mt-7 flex flex-col gap-3 md:flex-row">
      <a href="#contacto" class="btn btn-primary justify-center">Contame tu proyecto</a>
      <a href="/proyectos" class="btn btn-secondary justify-center">Ver proyectos</a>
    </div>
  </div>

  <div class="flex w-full shrink-0 justify-center md:w-[260px]">
    <HeroDiagram />
  </div>
</section>

---
import SectionHeader from '../SectionHeader.astro';
import Icon from '../Icon.astro';
import { SERVICES } from '../../data/services';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const projectsById = new Map(projects.map(p => [p.id, p]));

// El servicio declara qué evidencia lo respalda; el proyecto es dueño de sus assets.
// `evidence.image` es una clave semántica de la galería del proyecto; si falta,
// se usa la portada. Un proyecto sin imagen no recibe placeholder.
const resolvedServices = SERVICES.map(service => {
  const project = projectsById.get(service.evidence.project);
  if (!project) return { service, evidence: null };

  const { data } = project;
  let image = data.image;
  let imageAlt = data.imageAlt ?? `Captura de ${data.title}`;

  if (service.evidence.image && data.images) {
    const match = data.images.find(img => img.key === service.evidence.image);
    if (match) {
      image = match.src;
      imageAlt = match.alt;
    }
  }

  return {
    service,
    evidence: {
      href: `/proyectos/${project.id}`,
      label: data.brand ?? data.title,
      image,
      imageAlt,
    },
  };
});

const widgetClass = "mt-8 rounded-lg bg-accent-tint lg:grid lg:grid-cols-[minmax(0,0.75fr)_minmax(0,1.75fr)] lg:items-start lg:gap-x-9 lg:p-10 max-lg:block max-lg:px-5 max-lg:py-2";
const serviceClass = "block border-t border-[rgba(15,118,110,0.15)] first:border-t-0 lg:contents";
const headClass = "relative flex w-full items-center gap-3.5 bg-transparent py-[18px] text-left text-secondary transition-colors before:absolute before:-left-3.5 before:top-3 before:bottom-3 before:w-[3px] before:rounded-sm before:bg-transparent before:content-[''] hover:[&_.service-problem]:text-primary [&.is-active]:before:bg-accent [&.is-active_.service-icon]:text-accent [&.is-active_.service-problem]:font-semibold [&.is-active_.service-problem]:text-accent lg:col-start-1 lg:border-t lg:border-[rgba(15,118,110,0.15)] lg:first:border-t-0 lg:first:pt-0";
const panelClass = "relative hidden rounded-xl border border-border bg-background p-9 pb-8 pt-8 lg:col-start-2 lg:row-span-5 lg:row-start-1 lg:[&.is-active]:block max-lg:mb-5 max-lg:px-5 max-lg:py-5 max-lg:[&.is-open]:block";
const panelBodyClass = "relative min-w-0 lg:[&.has-media]:grid lg:[&.has-media]:grid-cols-2 lg:[&.has-media]:items-start lg:[&.has-media]:gap-x-9 lg:[&.has-media>*:not(.panel-media)]:col-start-1 lg:[&.has-media>.panel-media]:col-start-2 lg:[&.has-media>.panel-media]:row-span-6 lg:[&.has-media>.panel-media]:m-0";
const numClass = "flex-shrink-0 font-mono text-ui font-semibold text-accent";
const mediaClass = "relative my-6 w-full overflow-hidden rounded-[10px] border border-border bg-surface shadow-subtle [&_img]:block [&_img]:h-auto [&_img]:w-full";
const changeItemClass = "relative pl-5 text-base leading-[1.5] text-primary before:absolute before:left-0 before:text-accent before:content-['—']";
const evidenceClass = "relative mt-6 inline-flex items-center gap-1.5 rounded-lg border border-border px-3.5 py-[9px] text-ui font-semibold transition-colors hover:border-accent hover:bg-accent-tint";
---

<section id="servicios" class="py-section">
  <SectionHeader title="¿Qué necesitás resolver?" />
  <p class="section-intro">
    No necesitás llegar con una solución definida. Podemos empezar por el problema.
  </p>

  <div class={widgetClass} data-services>
    {resolvedServices.map(({ service, evidence }, i) => (
      <div class={serviceClass}>
        <button
          type="button"
          class={headClass}
          data-index={i}
          aria-expanded={i === 0 ? "true" : "false"}
          aria-controls={`svc-${service.id}`}
        >
          <span class={numClass}>{service.num}</span>
          <Icon name={service.icon} class="text-[1.2rem] text-muted transition-colors" />
          <span class="service-problem text-base leading-[1.4] transition-colors">{service.problem}</span>
        </button>

        <article
          id={`svc-${service.id}`}
          class:list={[panelClass, { "is-active": i === 0, "is-open": i === 0 }]}
          data-index={i}
          role="region"
          aria-labelledby={`svc-${service.id}-title`}
        >
          <div class:list={[panelBodyClass, { "has-media": Boolean(evidence?.image) }]}>
            <span class="pointer-events-none absolute -top-[18px] right-1 select-none text-[clamp(80px,10vw,128px)] font-bold leading-none text-[rgba(15,118,110,0.08)] max-lg:-top-3 max-lg:left-auto max-lg:right-0 max-lg:text-[72px]" aria-hidden="true">{service.num}</span>
            <Icon name={service.icon} class="relative mb-3.5 block text-[1.6rem] text-accent" />
            <h3 class="relative mb-3 text-title tracking-[-0.01em] text-primary" id={`svc-${service.id}-title`}>{service.title}</h3>
            <p class="relative text-base leading-[1.7] text-secondary">{service.description}</p>

            {evidence?.image && (
              <figure class={mediaClass}>
                <Image src={evidence.image} alt={evidence.imageAlt} loading="lazy" />
              </figure>
            )}

            <div class="relative mt-6 border-t border-border pt-5">
              <span class="mb-3 block text-micro font-bold uppercase tracking-[0.08em] text-accent">Qué cambia</span>
              <ul class="flex list-none flex-col gap-2">
                {service.changes.map(change => <li class={changeItemClass}>{change}</li>)}
              </ul>
            </div>

            <div class="flow relative mt-6" aria-hidden="true">
              {service.flow.map((step, idx) => (
                <>
                  <span class="flow-step">{step}</span>
                  {idx < service.flow.length - 1 && <span class="flow-sep">→</span>}
                </>
              ))}
            </div>

            {evidence && (
              <a class={evidenceClass} href={evidence.href}>
                Ejemplo: {evidence.label} →
              </a>
            )}
          </div>
        </article>
      </div>
    ))}
  </div>
</section>

<script>
  const widget = document.querySelector('[data-services]');
  if (widget) {
    const headEls = Array.from(widget.querySelectorAll<HTMLButtonElement>('button[aria-controls]'));
    const panels = Array.from(widget.querySelectorAll<HTMLElement>('[data-index][role="region"]'));
    const mq = window.matchMedia('(min-width: 1024px)');

    const setActive = (index: number) => {
      headEls.forEach((head, i) => {
        const active = i === index;
        head.classList.toggle('is-active', active);
        head.setAttribute('aria-expanded', active ? 'true' : 'false');
      });
      panels.forEach((panel, i) => panel.classList.toggle('is-active', i === index));
    };

    const toggleOpen = (index: number) => {
      const panel = panels[index];
      const wasOpen = panel.classList.contains('is-open');
      panels.forEach(p => p.classList.remove('is-open'));
      if (!wasOpen) panel.classList.add('is-open');
      headEls.forEach((head, i) => {
        head.setAttribute('aria-expanded', !wasOpen && i === index ? 'true' : 'false');
      });
    };

    headEls.forEach((head, i) => {
      head.addEventListener('click', () => {
        if (mq.matches) setActive(i);
        else toggleOpen(i);
      });
    });

    setActive(0);
    mq.addEventListener('change', () => setActive(0));
  }
</script>

---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { data, id: slug } = project;

const statusLabels = {
  ongoing: "En desarrollo",
  finished: "Completado",
  archived: "Archivado",
};
---

<article class="card" data-featured={data.featured}>
  <div class="header">
    <div>
      <h3>{data.title}</h3>
      {data.subtitle && <p class="subtitle">{data.subtitle}</p>}
    </div>
    <div class="header-actions">
      {data.repo && data.repo !== "#" && (
        <a href={data.repo} class="icon-link" target="_blank" rel="noopener" title="Repositorio">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
        </a>
      )}
      {data.live && data.live !== "#" && (
        <a href={data.live} class="icon-link" target="_blank" rel="noopener" title="Demo en vivo">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </a>
      )}
      <span class="status status-{data.status}">{statusLabels[data.status]}</span>
    </div>
  </div>

  <p class="description">{data.description}</p>

  {data.highlights && data.highlights.length > 0 && (
    <div class="highlights">
      {data.highlights.map(h => <span class="highlight-badge">{h}</span>)}
    </div>
  )}

  {data.challenge && (
    <div class="section">
      <span class="label">Reto técnico</span>
      <p>{data.challenge}</p>
    </div>
  )}

  {data.result && (
    <div class="section">
      <span class="label">Resultado</span>
      <p class="result">{data.result}</p>
    </div>
  )}

  <div class="footer">
    <div class="tech-tags">
      {data.tech.map(t => <span class="tag">{t}</span>)}
    </div>
    <a href={`/proyectos/${slug}`} class="link">
      Ver caso completo <span class="arrow">→</span>
    </a>
  </div>
</article>

<style>
  .card {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 24px;
    transition: border-color 0.2s, transform 0.2s;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .card:hover {
    border-color: var(--border-hover);
    transform: translateY(-2px);
  }

  .card[data-featured="true"] {
    border-color: var(--border-hover);
    box-shadow: 0 0 24px var(--accent-glow);
  }

  .header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
  }

  .header h3 {
    color: var(--text-primary);
  }

  .subtitle {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-top: 4px;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .icon-link {
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    padding: 4px;
    border-radius: 4px;
    transition: color 0.2s, background 0.2s;
  }

  .icon-link:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.05);
  }

  .status {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 4px 10px;
    border-radius: 4px;
    white-space: nowrap;
    font-weight: 600;
  }

  .status-ongoing {
    background: rgba(234, 179, 8, 0.12);
    color: #FBBF24;
    border: 1px solid rgba(234, 179, 8, 0.25);
  }

  .status-finished {
    background: rgba(74, 222, 128, 0.12);
    color: #4ADE80;
    border: 1px solid rgba(74, 222, 128, 0.25);
  }

  .status-archived {
    background: rgba(107, 114, 128, 0.12);
    color: #9CA3AF;
    border: 1px solid rgba(107, 114, 128, 0.25);
  }

  .description {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .highlight-badge {
    background: rgba(124, 58, 237, 0.1);
    border: 1px solid rgba(124, 58, 237, 0.2);
    color: var(--accent-soft);
    font-size: 0.75rem;
    padding: 4px 10px;
    border-radius: 6px;
    font-weight: 600;
    white-space: nowrap;
  }

  .section {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-soft);
    font-weight: 600;
  }

  .section p {
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .result {
    color: var(--text-primary) !important;
    font-weight: 500;
  }

  .footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-top: auto;
    flex-wrap: wrap;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tag {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-secondary);
    font-size: 0.7rem;
    padding: 3px 8px;
    border-radius: 4px;
    font-weight: 500;
  }

  .link {
    font-size: 0.85rem;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--accent-soft);
    transition: gap 0.2s;
    flex-shrink: 0;
  }

  .link:hover {
    gap: 8px;
    color: var(--accent);
  }

  .link:hover .arrow {
    transform: translateX(2px);
  }

  .arrow {
    transition: transform 0.2s;
  }

  @media (max-width: 480px) {
    .footer {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

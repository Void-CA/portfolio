---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { data, id: slug } = project;

const statusLabels: Record<string, string> = {
  ongoing: "En desarrollo",
  finished: "Entregado",
  archived: "Exploración",
};

const originLabels: Record<string, string> = {
  client: "Trabajo para cliente",
  own: "Proyecto propio",
};

const statusLabel = statusLabels[data.status] || "";
const originLabel = data.kind ? originLabels[data.kind] : "";
---

<article class="card">
  {data.image && (
    <div class="card-image">
      <Image src={data.image} alt="" loading="lazy" />
    </div>
  )}

  {data.brand && <span class="brand">{data.brand}</span>}
  <h3 class="title">
    <a href={`/proyectos/${slug}`} class="cover-link">{data.title}</a>
  </h3>

  <p class="description">{data.description}</p>

  {data.highlights && data.highlights.length > 0 && (
    <div class="chip chip--data">{data.highlights[0]}</div>
  )}

  <div class="meta">
    <span class="origin">
      {originLabel}
      {originLabel && statusLabel && <span class="sep">·</span>}
      {statusLabel}
    </span>
    <span class="arrow">→</span>
  </div>
</article>

<style>
  .card {
    position: relative;
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    box-shadow: var(--shadow-subtle);
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
    height: 100%;
  }

  .card:hover {
    border-color: var(--color-border-hover);
    box-shadow: var(--shadow-card);
  }

  .card-image {
    margin: -20px -20px 12px;
    border-radius: 12px 12px 0 0;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--color-surface);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cover-link {
    color: inherit;
    text-decoration: none;
  }

  .cover-link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 12px;
  }

  .cover-link:focus-visible::after {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .brand {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    color: var(--color-accent);
    margin-bottom: -4px;
  }

  .title {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-primary);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .card:hover .title {
    color: var(--color-accent);
  }

  .description {
    color: var(--color-secondary);
    font-size: 0.85rem;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 10px;
    border-top: 1px solid var(--color-border);
  }

  .origin {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
    color: var(--color-muted);
    min-width: 0;
  }

  .origin .sep {
    opacity: 0.5;
  }

  .arrow {
    font-size: 0.85rem;
    color: var(--color-accent);
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .card:hover .arrow {
    transform: translateX(3px);
  }

  .card :global(.chip) {
    align-self: flex-start;
  }

  @media (max-width: 639.98px) {
    .card {
      padding: 16px;
    }

    .card-image {
      margin: -16px -16px 12px;
    }
  }
</style>

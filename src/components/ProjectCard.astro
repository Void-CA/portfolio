---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { data, slug } = project;

const statusLabels = {
  ongoing: "En desarrollo",
  finished: "Completado",
  archived: "Archivado",
};

const statusColors = {
  ongoing: "border-yellow-500/30 text-yellow-400",
  finished: "border-green-500/30 text-green-400",
  archived: "border-gray-500/30 text-gray-400",
};
---

<article class="card" data-featured={data.featured}>
  <div class="header">
    <div>
      <h3>{data.title}</h3>
      {data.subtitle && <p class="subtitle">{data.subtitle}</p>}
    </div>
    <span class="status" class:list={[`status-${data.status}`]}>{statusLabels[data.status]}</span>
  </div>

  <p class="description">{data.description}</p>

  {data.problem && (
    <div class="section">
      <span class="label">Problema</span>
      <p>{data.problem}</p>
    </div>
  )}

  {data.result && (
    <div class="section">
      <span class="label">Resultado</span>
      <p class="result">{data.result}</p>
    </div>
  )}

  <div class="tech-tags">
    {data.tech.map(t => <span class="tag">{t}</span>)}
  </div>

  <a href={`/proyectos/${slug}`} class="link">
    Ver caso completo →
  </a>
</article>

<style>
  .card {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 24px;
    transition: border-color 0.2s, transform 0.2s;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .card:hover {
    border-color: var(--border-hover);
    transform: translateY(-2px);
  }

  .card[data-featured="true"] {
    border-color: var(--accent-glow);
    box-shadow: 0 0 24px var(--accent-glow);
  }

  .header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
  }

  .header h3 {
    color: var(--text-primary);
  }

  .subtitle {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-top: 4px;
  }

  .status {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 4px 8px;
    border: 1px solid;
    border-radius: 4px;
    white-space: nowrap;
    font-weight: 500;
  }

  .status-ongoing {
    border-color: rgba(234, 179, 8, 0.3);
    color: #EAB308;
  }

  .status-finished {
    border-color: rgba(74, 222, 128, 0.3);
    color: #4ADE80;
  }

  .status-archived {
    border-color: rgba(107, 114, 128, 0.3);
    color: #9CA3AF;
  }

  .description {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .section {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-soft);
    font-weight: 600;
  }

  .section p {
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .result {
    color: var(--text-primary) !important;
    font-weight: 500;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
  }

  .tag {
    background: var(--accent-glow);
    color: var(--accent-soft);
    font-size: 0.7rem;
    padding: 3px 8px;
    border-radius: 4px;
    font-weight: 500;
  }

  .link {
    font-size: 0.85rem;
    font-weight: 500;
    margin-top: 8px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--accent-soft);
    transition: gap 0.2s;
  }

  .link:hover {
    gap: 8px;
    color: var(--accent);
  }
</style>

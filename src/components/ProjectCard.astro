---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { data, id: slug } = project;

// Determinar personalidad según áreas
const personalityMap: Record<string, string> = {
  systems: "terminal",
  cli: "terminal",
  monitoring: "terminal",
  backend: "clean",
  api: "clean",
  domain: "clean",
  data: "grid",
  "time-series": "grid",
  web: "fluid",
  frontend: "fluid",
};

const personality = personalityMap[data.areas?.[0] || "backend"] || "clean";

const statusLabels: Record<string, string> = {
  ongoing: "Experimental",
  finished: "",
  archived: "Archivado",
};

// Mapeo de áreas a etiquetas de display (Nivel 1)
const areaLabels: Record<string, string> = {
  systems: "Sistemas",
  cli: "CLI",
  monitoring: "Observabilidad",
  backend: "Backend",
  "desktop development": "Desktop",
  "domain modeling": "Modelado de Dominio",
  "system design": "Diseño de Sistemas",
  "financial systems": "Fintech",
  automation: "Automatización",
  "systems programming": "Sistemas",
  "database architecture": "Bases de Datos",
  "api design": "APIs",
  data: "Data",
  web: "Web",
  architecture: "Arquitectura",
  "agriculture technology": "AgriTech",
};

// Tags visibles en Nivel 1: priorizar áreas, completar con tech, max 3
const domainTags = (data.areas || []).slice(0, 2).map(a => areaLabels[a] || a);
const techLimit = Math.max(0, 3 - domainTags.length);
const techTags = data.tech.slice(0, techLimit);
const displayTags = [...domainTags, ...techTags];

const showStatus = data.status !== "finished";
const statusLabel = statusLabels[data.status] || "";
---

<article class="card" data-personality={personality}>
  <h3 class="title">
    <a href={`/proyectos/${slug}`} class="cover-link">{data.title}</a>
  </h3>

  <p class="description">{data.description}</p>

  <div class="meta">
    <div class="tags">
      {displayTags.map((tag, i) => (
        <>
          <span class="tag">{tag}</span>
          {i < displayTags.length - 1 && <span class="sep">·</span>}
        </>
      ))}
    </div>

    <span class="end">
      {showStatus && <span class="status">{statusLabel}</span>}
      <span class="arrow">→</span>
    </span>
  </div>
</article>

<style>
  .card {
    position: relative;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
    height: 100%;
  }

  .card:hover {
    border-color: var(--border-hover);
    box-shadow: 0 0 0 1px rgba(139, 92, 246, 0.12);
  }

  /* Cover link — toda la card es clickeable */
  .cover-link {
    color: inherit;
    text-decoration: none;
  }

  .cover-link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 12px;
  }

  .cover-link:focus-visible::after {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .title {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .card:hover .title {
    color: var(--accent-soft);
  }

  .description {
    color: var(--text-secondary);
    font-size: 0.85rem;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 2px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
    min-width: 0;
  }

  .tag {
    font-size: 0.7rem;
    color: var(--text-secondary);
    font-weight: 500;
    white-space: nowrap;
  }

  .sep {
    font-size: 0.7rem;
    color: var(--text-secondary);
    opacity: 0.4;
  }

  .end {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
    opacity: 0.5;
    transition: opacity 0.2s ease;
  }

  .card:hover .end {
    opacity: 1;
  }

  .status {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .arrow {
    font-size: 0.85rem;
    color: var(--accent-soft);
    transition: transform 0.2s ease;
  }

  .card:hover .arrow {
    transform: translateX(3px);
  }

  /* Terminal personality: más denso, mono para metadata */
  .card[data-personality="terminal"] {
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
  }

  .card[data-personality="terminal"] .title {
    font-size: 1rem;
  }

  .card[data-personality="terminal"] .tag,
  .card[data-personality="terminal"] .status {
    font-size: 0.65rem;
  }

  /* Fluid personality: transiciones suaves */
  .card[data-personality="fluid"] {
    transition: all 0.3s ease;
  }

  @media (max-width: 480px) {
    .card {
      padding: 16px;
    }

    .meta {
      flex-wrap: wrap;
    }
  }
</style>

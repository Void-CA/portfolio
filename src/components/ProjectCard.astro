---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { data, id: slug } = project;

// Determinar personalidad según áreas
const personalityMap: Record<string, string> = {
  systems: "terminal",
  cli: "terminal",
  monitoring: "terminal",
  backend: "clean",
  api: "clean",
  domain: "clean",
  data: "grid",
  "time-series": "grid",
  web: "fluid",
  frontend: "fluid",
};

const personality = personalityMap[data.areas?.[0] || "backend"] || "clean";

const statusLabels = {
  ongoing: "En desarrollo",
  finished: "Completado",
  archived: "Archivado",
};

// Limitar highlights a 2
const displayHighlights = data.highlights?.slice(0, 2) || [];
const displayTech = data.tech.slice(0, 6);
---

<article class="card" data-personality={personality}>
  <div class="header">
    <div>
      <h3>{data.title}</h3>
      {data.subtitle && <p class="subtitle">{data.subtitle}</p>}
    </div>
    {data.status !== 'finished' && (
      <span class="status status-{data.status}">{statusLabels[data.status]}</span>
    )}
  </div>

  <p class="description">{data.description}</p>

  {displayHighlights.length > 0 && (
    <div class="highlights">
      {displayHighlights.map(h => <span class="highlight-pill">{h}</span>)}
    </div>
  )}

  <div class="footer">
    <div class="stack">
      {displayTech.map((t, i) => (
        <>
          <span class="tech-item">{t}</span>
          {i < displayTech.length - 1 && <span class="bullet">·</span>}
        </>
      ))}
      {data.tech.length > 6 && <span class="tech-more">+{data.tech.length - 6}</span>}
    </div>
    <a href={`/proyectos/${slug}`} class="link">
      Ver caso completo <span class="arrow">→</span>
    </a>
  </div>
</article>

<style>
  .card {
    background: var(--bg-surface);
    border: 1px solid transparent;
    border-radius: 12px;
    padding: var(--card-padding, 20px);
    transition: border-color 0.2s, transform 0.2s;
    display: flex;
    flex-direction: column;
    gap: var(--card-gap, 16px);
    height: 100%;
  }

  .card:hover {
    border-color: var(--border-hover);
    transform: translateY(-2px);
  }

  .header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
  }

  .header h3 {
    color: var(--text-primary);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .subtitle {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-top: 4px;
  }

  .status {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 3px 8px;
    border-radius: 4px;
    white-space: nowrap;
    font-weight: 600;
    flex-shrink: 0;
  }

  .status-ongoing {
    background: rgba(234, 179, 8, 0.12);
    color: #FBBF24;
    border: 1px solid rgba(234, 179, 8, 0.25);
  }

  .status-finished {
    background: rgba(74, 222, 128, 0.12);
    color: #4ADE80;
    border: 1px solid rgba(74, 222, 128, 0.25);
  }

  .status-archived {
    background: rgba(107, 114, 128, 0.12);
    color: #9CA3AF;
    border: 1px solid rgba(107, 114, 128, 0.25);
  }

  .description {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .highlight-pill {
    background: rgba(124, 58, 237, 0.1);
    border: 1px solid rgba(124, 58, 237, 0.2);
    color: var(--accent-soft);
    font-size: 0.7rem;
    padding: 3px 8px;
    border-radius: 4px;
    font-weight: 500;
    white-space: nowrap;
  }

  .footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-top: auto;
    flex-wrap: wrap;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    align-items: center;
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .tech-item {
    font-weight: 500;
  }

  .bullet {
    color: var(--text-secondary);
    opacity: 0.5;
  }

  .tech-more {
    color: var(--accent-soft);
    font-weight: 500;
  }

  .link {
    font-size: 0.8rem;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--accent-soft);
    transition: gap 0.2s;
    flex-shrink: 0;
  }

  .link:hover {
    gap: 8px;
    color: var(--accent);
  }

  .arrow {
    transition: transform 0.2s;
  }

  /* Terminal personality: más denso, feeling CLI */
  .card[data-personality="terminal"] {
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
  }

  .card[data-personality="terminal"] .header h3 {
    font-size: 1.1rem;
  }

  .card[data-personality="terminal"] .description {
    font-size: 0.85rem;
  }

  /* Grid personality: same as clean */
  .card[data-personality="grid"] {
    /* inherited from .card */
  }

  /* Fluid personality: transiciones suaves */
  .card[data-personality="fluid"] {
    transition: all 0.3s ease;
  }

  @media (max-width: 480px) {
    .footer {
      flex-direction: column;
      align-items: flex-start;
    }

    .stack {
      font-size: 0.7rem;
    }
  }
</style>
---
// Motivo de sistema: problema → sistema → resultado.
// Abstracto y decorativo (aria-hidden): no aporta información única.
---

<div class="hero-diagram" aria-hidden="true">
  <svg viewBox="0 0 240 268" role="presentation">
    <line class="rail" x1="24" y1="30" x2="24" y2="238" />

    <circle class="node" cx="24" cy="30" r="6" />
    <circle class="node node-system" cx="24" cy="134" r="7" />
    <circle class="node" cx="24" cy="238" r="6" />

    <text class="label" x="48" y="35">Problema</text>
    <text class="label label-system" x="48" y="139">Sistema</text>
    <text class="label" x="48" y="243">Resultado</text>
  </svg>
</div>

<style>
  .hero-diagram {
    width: 100%;
    max-width: 260px;
  }

  .hero-diagram svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .rail {
    stroke: var(--border);
    stroke-width: 2;
  }

  .node {
    fill: var(--bg-primary);
    stroke: var(--border);
    stroke-width: 2;
  }

  .node-system {
    fill: var(--accent);
    stroke: var(--accent);
  }

  .label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    fill: var(--text-muted);
  }

  .label-system {
    fill: var(--accent);
    font-weight: 600;
  }
</style>

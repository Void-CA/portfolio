---
import { IDENTITY } from './SiteConfig';

const navLinks = [
  { href: '/#servicios', label: 'Servicios' },
  { href: '/proyectos', label: 'Proyectos' },
  { href: '/#sobre-mi', label: 'Sobre mí' },
  { href: '/#contacto', label: 'Contacto' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  !href.startsWith('/#') && (currentPath === href || (href !== '/' && currentPath.startsWith(href)));
---

<header class="header">
  <div class="inner">
    <a href="/" class="logo">
      <span class="logo-dot"></span>
      <span class="identity-name">{IDENTITY.name}</span>
      <span class="identity-role">{IDENTITY.roleTag}</span>
    </a>
    <nav>
      <ul>
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              class:list={[{ active: isActive(link.href) }]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(12px);
  }

  .inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 16px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    flex-shrink: 0;
    white-space: nowrap;
  }

  .logo-dot {
    width: 8px;
    height: 8px;
    background: var(--accent);
    border-radius: 50%;
  }

  nav ul {
    display: flex;
    gap: 24px;
    list-style: none;
    flex-wrap: nowrap;
  }

  nav a {
    color: var(--text-secondary);
    font-size: 0.9rem;
    font-weight: 500;
    padding: 4px 0;
    border-bottom: 1px solid transparent;
    transition: color 0.2s, border-color 0.2s;
    white-space: nowrap;
  }

  nav a:hover {
    color: var(--text-primary);
  }

  nav a.active {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .identity-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .identity-role {
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--text-muted);
    padding-left: 10px;
    border-left: 1px solid var(--border);
    margin-left: 10px;
    white-space: nowrap;
  }

  @media (max-width: 820px) {
    .identity-role {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .inner {
      padding: 14px 16px;
      gap: 10px;
    }

    nav ul {
      gap: 12px;
    }

    nav a {
      font-size: 0.78rem;
    }

    .identity-name {
      font-size: 0.9rem;
    }
  }
</style>

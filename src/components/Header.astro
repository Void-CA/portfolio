---
import { IDENTITY } from './SiteConfig';

const navLinks = [
  { href: '/#servicios', label: 'Servicios' },
  { href: '/proyectos', label: 'Proyectos' },
  { href: '/#sobre-mi', label: 'Sobre mí' },
  { href: '/#contacto', label: 'Contacto' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  !href.startsWith('/#') && (currentPath === href || (href !== '/' && currentPath.startsWith(href)));
---

<header class="header">
  <div class="inner">
    <a href="/" class="logo">
      <span class="logo-dot"></span>
      <span class="identity-name">{IDENTITY.name}</span>
      <span class="identity-role">{IDENTITY.roleTag}</span>
    </a>
    <nav>
      <ul>
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              class:list={[{ active: isActive(link.href) }]}
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.header');

  // Elevación contextual: al scrollear, el header se separa del contenido que pasa por debajo.
  if (header) {
    const setScrolled = () => header.classList.toggle('is-scrolled', window.scrollY > 4);
    window.addEventListener('scroll', setScrolled, { passive: true });
    setScrolled();
  }

  const path = window.location.pathname;
  const isHome = path === '/' || path === '/index.html';

  if (isHome && header) {
    const targets = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('.header nav a[href*="#"]')
    )
      .map(a => {
        const id = (a.getAttribute('href') || '').split('#')[1];
        const el = id ? document.getElementById(id) : null;
        return el ? { a, el } : null;
      })
      .filter((t): t is { a: HTMLAnchorElement; el: HTMLElement } => t !== null);

    if (targets.length > 0) {
      const offset = header.getBoundingClientRect().height + 16;

      const update = () => {
        let current: (typeof targets)[number] | null = null;
        for (const t of targets) {
          if (t.el.getBoundingClientRect().top - offset <= 0) current = t;
        }
        targets.forEach(t => {
          const active = t === current;
          t.a.classList.toggle('active', active);
          if (active) t.a.setAttribute('aria-current', 'location');
          else t.a.removeAttribute('aria-current');
        });
      };

      let ticking = false;
      const request = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          update();
          ticking = false;
        });
      };

      window.addEventListener('scroll', request, { passive: true });
      window.addEventListener('resize', request);
      update();
    }
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid var(--color-border);
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(12px);
    transition: box-shadow 0.25s ease;
  }

  .header.is-scrolled {
    box-shadow: var(--shadow-floating);
  }

  .inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 16px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: var(--text-lead);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-primary);
    flex-shrink: 0;
    white-space: nowrap;
  }

  .logo-dot {
    width: 8px;
    height: 8px;
    background: var(--color-accent);
    border-radius: 50%;
  }

  nav ul {
    display: flex;
    gap: 24px;
    list-style: none;
    flex-wrap: nowrap;
  }

  nav a {
    color: var(--color-secondary);
    font-size: var(--text-base);
    font-weight: 500;
    padding: 4px 0;
    border-bottom: 1px solid transparent;
    transition: color 0.2s, border-color 0.2s;
    white-space: nowrap;
  }

  nav a:hover {
    color: var(--color-primary);
  }

  nav a.active {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  .identity-name {
    font-size: var(--text-lead);
    font-weight: 600;
    color: var(--color-primary);
  }

  .identity-role {
    font-size: var(--text-meta);
    font-weight: 400;
    color: var(--color-muted);
    padding-left: 10px;
    border-left: 1px solid var(--color-border);
    margin-left: 10px;
    white-space: nowrap;
  }

  @media (max-width: 767.98px) {
    .identity-role {
      display: none;
    }
  }

  @media (max-width: 639.98px) {
    .inner {
      padding: 14px 16px;
      gap: 10px;
    }

    nav ul {
      gap: 12px;
    }

    nav a {
      font-size: var(--text-meta);
    }

    .identity-name {
      font-size: var(--text-base);
    }
  }
</style>

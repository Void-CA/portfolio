---
import type { CollectionEntry } from "astro:content";

interface Props {
  skill: CollectionEntry<"skills">;
}

const { skill } = Astro.props;
const { data, id: slug } = skill;

const statement = data.statement || data.description;
const impactAreas = data.impact_areas || data.problems?.slice(0, 3) || [];
---

<article class="skill-card" data-size={data.level === "advanced" ? "large" : "medium"}>
  <a href={`/skills/${slug}`}>
    <span class="tech-label">{data.name}</span>
    <blockquote class="statement">"{statement}"</blockquote>
    <span class="context">{impactAreas.slice(0, 3).join(" / ")}</span>
  </a>
</article>

<style>
  .skill-card {
    padding: 24px 0;
    border-bottom: 1px solid var(--border);
    transition: border-color 0.2s;
  }

  .skill-card:hover {
    border-color: var(--accent);
  }

  .skill-card[data-size="large"] {
    padding: 32px 0;
  }

  .skill-card a {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .tech-label {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
  }

  .statement {
    font-size: 1.1rem;
    font-weight: 400;
    line-height: 1.45;
    color: var(--text-primary);
    margin: 0;
    padding: 0;
    border: none;
    font-style: normal;
  }

  .skill-card[data-size="large"] .statement {
    font-size: 1.25rem;
    line-height: 1.4;
  }

  .context {
    font-size: 0.75rem;
    color: var(--text-secondary);
    opacity: 0.7;
  }

  @media (max-width: 640px) {
    .skill-card {
      padding: 20px 0;
    }

    .statement {
      font-size: 1rem;
    }

    .skill-card[data-size="large"] .statement {
      font-size: 1.1rem;
    }
  }
</style>
---
import type { CollectionEntry } from "astro:content";

interface Props {
  skill: CollectionEntry<"skills">;
}

const { skill } = Astro.props;
const { data, id: slug } = skill;

const statement = data.statement || data.description;
const impactAreas = data.impact_areas || data.problems?.slice(0, 3) || [];
---

<article class="skill-card" data-size={data.level === "advanced" ? "large" : "medium"}>
  <a href={`/skills/${slug}`}>
    <span class="tech-label">{data.name}</span>
    <blockquote class="statement">"{statement}"</blockquote>
    <span class="context">{impactAreas.slice(0, 3).join(" / ")}</span>
  </a>
</article>

<style>
  .skill-card {
    padding: 32px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    transition: all 0.25s ease;
    cursor: pointer;
    position: relative;
  }

  .skill-card::before {
    content: "";
    position: absolute;
    left: 0;
    top: 32px;
    bottom: 32px;
    width: 2px;
    background: var(--accent);
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .skill-card:hover {
    border-color: rgba(124, 58, 237, 0.2);
    padding-left: 16px;
  }

  .skill-card:hover::before {
    opacity: 1;
  }

  .skill-card[data-size="large"] {
    padding: 40px 0;
  }

  .skill-card[data-size="large"]::before {
    top: 40px;
    bottom: 40px;
  }

  .skill-card[data-size="large"]:hover {
    padding-left: 20px;
  }

  .skill-card a {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .tech-label {
    font-size: 1.25rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    transition: color 0.25s ease;
  }

  .skill-card:hover .tech-label {
    color: var(--text-primary);
  }

  .statement {
    font-size: 1.1rem;
    font-weight: 400;
    line-height: 1.45;
    color: var(--text-primary);
    margin: 0;
    padding: 0;
    border: none;
    font-style: normal;
    transition: color 0.25s ease;
  }

  .skill-card:hover .statement {
    color: var(--accent-soft);
  }

  .skill-card[data-size="large"] .statement {
    font-size: 1.25rem;
    line-height: 1.4;
  }

  .context {
    font-size: 0.75rem;
    color: var(--text-secondary);
    opacity: 0.7;
    transition: opacity 0.25s ease;
  }

  .skill-card:hover .context {
    opacity: 1;
  }

  @media (max-width: 640px) {
    .skill-card {
      padding: 24px 0;
    }

    .skill-card[data-size="large"] {
      padding: 32px 0;
    }

    .skill-card:hover {
      padding-left: 12px;
    }

    .statement {
      font-size: 1rem;
    }

    .skill-card[data-size="large"] .statement {
      font-size: 1.1rem;
    }
  }
</style>
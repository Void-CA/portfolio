---
import { IDENTITY } from '../SiteConfig';

const navLinks = [
  { href: '/#servicios', label: 'Servicios' },
  { href: '/proyectos', label: 'Proyectos' },
  { href: '/sobre-mi', label: 'Sobre mí' },
  { href: '/#contacto', label: 'Contacto' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  !href.startsWith('/#') && (currentPath === href || (href !== '/' && currentPath.startsWith(href)));
---

<header
  data-header
  class="sticky top-0 z-[100] border-b border-border bg-background/90 backdrop-blur-md transition-shadow duration-200 data-[scrolled]:shadow-floating"
>
  <div class="mx-auto flex max-w-350 items-center gap-4 px-6 py-4 max-md:gap-2.5 max-md:px-3 max-md:py-3">
    <a
      href="/"
      class="flex flex-shrink-0 items-center whitespace-nowrap text-lead font-semibold tracking-[-0.01em] text-primary"
    >
      <span class="text-lead font-semibold text-primary max-md:text-ui max-[410px]:text-base">{IDENTITY.name}</span>
      <span class="ml-2.5 border-l border-border pl-2.5 text-meta font-normal text-muted max-md:hidden">{IDENTITY.roleTag}</span>
    </a>

    <!-- Nav horizontal: se muestra desde 410px. Por debajo, hamburguesa. -->
    <nav class="ml-auto min-w-0 flex-1 max-md:-mr-3 max-md:overflow-x-auto max-md:[scrollbar-width:none] max-md:[&::-webkit-scrollbar]:hidden max-[410px]:hidden">
      <ul class="flex list-none flex-nowrap items-center justify-end gap-6 max-md:gap-4 max-md:pr-3">
        {navLinks.map(link => (
          <li class="max-md:shrink-0">
            <a
              href={link.href}
              class="whitespace-nowrap border-b border-transparent py-1 text-base font-medium text-secondary transition-colors hover:text-primary aria-[current]:border-accent aria-[current]:text-accent max-md:text-ui"
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Hamburguesa: solo en pantallas muy angostas. -->
    <button
      type="button"
      class="ml-auto hidden h-9 w-9 flex-shrink-0 items-center justify-center rounded-md border border-border text-primary transition-colors hover:border-accent hover:text-accent max-[410px]:inline-flex"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menÃº"
    >
      <span class="relative block h-3.5 w-5" aria-hidden="true">
        <span class="absolute left-0 top-0 h-0.5 w-full rounded bg-current transition-transform duration-200 data-[open]:translate-y-[6px] data-[open]:rotate-45"></span>
        <span class="absolute left-0 top-1.5 h-0.5 w-full rounded bg-current transition-opacity duration-200 data-[open]:opacity-0"></span>
        <span class="absolute left-0 top-3 h-0.5 w-full rounded bg-current transition-transform duration-200 data-[open]:-translate-y-[6px] data-[open]:-rotate-45"></span>
      </span>
    </button>
  </div>

  <!-- Panel del menÃº mÃ³vil: el atributo `hidden` manda; solo se muestra en
       pantallas muy angostas y cuando el menÃº estÃ¡ abierto. -->
  <nav
    id="mobile-menu"
    class="border-t border-border bg-background max-[410px]:[&:not([hidden])]:block"
    data-menu-panel
    hidden
  >
    <ul class="mx-auto flex max-w-350 list-none flex-col px-3 py-1">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class="block border-b border-border px-2 py-3 text-base font-medium text-secondary transition-colors last:border-b-0 hover:text-primary aria-[current]:text-accent"
            aria-current={isActive(link.href) ? 'page' : undefined}
            data-menu-link
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');

  // ElevaciÃ³n contextual: al scrollear, el header se separa del contenido que pasa por debajo.
  if (header) {
    const setScrolled = () => header.toggleAttribute('data-scrolled', window.scrollY > 4);
    window.addEventListener('scroll', setScrolled, { passive: true });
    setScrolled();
  }

  // MenÃº hamburguesa (solo visible por debajo de 410px).
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');

  if (toggle && panel) {
    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Cerrar menÃº' : 'Abrir menÃº');
      toggle.querySelectorAll<HTMLElement>('span > span').forEach(bar => bar.toggleAttribute('data-open', open));
    };

    toggle.addEventListener('click', () => setOpen(panel.hidden === true));

    panel.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('[data-menu-link]')) setOpen(false);
    });

    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !panel.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });

    window.matchMedia('(min-width: 410px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }

  const path = window.location.pathname;
  const isHome = path === '/' || path === '/index.html';

  if (isHome && header) {
    const targets = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('[data-header] nav a[href*="#"]')
    )
      .map(a => {
        const id = (a.getAttribute('href') || '').split('#')[1];
        const el = id ? document.getElementById(id) : null;
        return el ? { a, el } : null;
      })
      .filter((t): t is { a: HTMLAnchorElement; el: HTMLElement } => t !== null);

    if (targets.length > 0) {
      const offset = header.getBoundingClientRect().height + 16;

      const update = () => {
        let current: (typeof targets)[number] | null = null;
        for (const t of targets) {
          if (t.el.getBoundingClientRect().top - offset <= 0) current = t;
        }
        targets.forEach(t => {
          const active = t === current;
          if (active) t.a.setAttribute('aria-current', 'location');
          else t.a.removeAttribute('aria-current');
        });
      };

      let ticking = false;
      const request = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          update();
          ticking = false;
        });
      };

      window.addEventListener('scroll', request, { passive: true });
      window.addEventListener('resize', request);
      update();
    }
  }
</script>

---
import Icon from './Icon.astro';
import { CONTACT } from './SiteConfig';

const { email, github, linkedin } = CONTACT;
const year = new Date().getFullYear();

const linkClass = "inline-flex items-center gap-1.5 whitespace-nowrap text-ui text-secondary transition-colors hover:text-accent [&_svg]:shrink-0 [&_svg]:opacity-60 hover:[&_svg]:opacity-100";
const sepClass = "text-ui text-border max-sm:hidden";
---

<footer class="mt-20 border-t border-border px-6 py-8 max-md:px-4 max-md:py-6">
  <div class="mx-auto flex max-w-[1200px] flex-col gap-4">
    <div class="flex flex-wrap items-center gap-x-2 gap-y-1.5">
      <a href={`mailto:${email}`} class={linkClass} aria-label={`Escribime a ${email}`}>
        <Icon name="mail" class="text-[1rem]" />
        <span class="max-sm:hidden">{email}</span>
      </a>
      <span class={sepClass} aria-hidden="true">·</span>
      <a href={github} class={linkClass} target="_blank" rel="noopener" aria-label="GitHub">
        <Icon name="github" class="text-[1rem]" />
        <span class="max-sm:hidden">GitHub</span>
      </a>
      <span class={sepClass} aria-hidden="true">·</span>
      <a href={linkedin} class={linkClass} target="_blank" rel="noopener" aria-label="LinkedIn">
        <Icon name="linkedin" class="text-[1rem]" />
        <span class="max-sm:hidden">LinkedIn</span>
      </a>
    </div>
    <p class="text-meta text-secondary opacity-50">{year} — Software a medida, automatización y datos.</p>
  </div>
</footer>

---
import Icon from './Icon.astro';
import { CONTACT } from './SiteConfig';

const { email, github, linkedin } = CONTACT;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="inner">
    <div class="contact-row">
      <a href={`mailto:${email}`} class="contact-link" aria-label={`Escribime a ${email}`}>
        <Icon name="mail" class="contact-icon" />
        <span>{email}</span>
      </a>
      <span class="contact-sep" aria-hidden="true">·</span>
      <a href={github} class="contact-link" target="_blank" rel="noopener" aria-label="GitHub">
        <Icon name="github" class="contact-icon" />
        <span>GitHub</span>
      </a>
      <span class="contact-sep" aria-hidden="true">·</span>
      <a href={linkedin} class="contact-link" target="_blank" rel="noopener" aria-label="LinkedIn">
        <Icon name="linkedin" class="contact-icon" />
        <span>LinkedIn</span>
      </a>
    </div>
    <p class="tagline">{year} — Software a medida, automatización y datos.</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    padding: 32px 24px;
    margin-top: 80px;
  }

  .inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .contact-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    row-gap: 6px;
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
    color: var(--color-secondary);
    transition: color 0.2s;
    white-space: nowrap;
  }

  .contact-link:hover {
    color: var(--color-accent);
  }

  .contact-icon {
    font-size: 1rem;
  }

  .contact-link svg {
    flex-shrink: 0;
    opacity: 0.6;
  }

  .contact-link:hover svg {
    opacity: 1;
  }

  .contact-sep {
    color: var(--color-border);
    font-size: 0.85rem;
  }

  .tagline {
    font-size: 0.75rem;
    color: var(--color-secondary);
    opacity: 0.5;
  }

  @media (max-width: 639.98px) {
    .footer {
      padding: 24px 16px;
    }

    .contact-link span {
      display: none;
    }

    .contact-sep {
      display: none;
    }
  }
</style>

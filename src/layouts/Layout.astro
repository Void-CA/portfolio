---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { IDENTITY, CONTACT, SOCIAL } from '../components/SiteConfig';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Software a medida, automatización y datos para tu operación." } = Astro.props;

const pageTitle = `${title} | ${IDENTITY.name}`;
const pageDescription = description;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: IDENTITY.fullName,
  description: SOCIAL.description,
  email: CONTACT.email,
  sameAs: [CONTACT.github, CONTACT.linkedin],
  url: Astro.url.origin,
  serviceType: [
    "Desarrollo de software a medida",
    "Automatización de procesos",
    "Integración de APIs y datos",
  ],
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={pageDescription} />
		<meta name="theme-color" content="#FFFFFF" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>

		<!-- Open Graph -->
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:type" content="website" />
		<meta property="og:image" content={`${Astro.url.origin}${SOCIAL.ogImage}`} />
		<meta property="og:url" content={Astro.url.href} />
		<meta name="twitter:card" content="summary_large_image" />

		<!-- JSON-LD -->
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body>
		<div class="page">
			<Header />
			<main>
				<slot />
			</main>
			<Footer />
		</div>
	</body>
</html>

<style>
	:global(:root) {
		--bg-primary: #FFFFFF;
		--bg-surface: #F5F8F8;
		--bg-surface-hover: #EDF2F2;
		--accent: #0F766E;
		--accent-strong: #115E59;
		--accent-bright: #0D9488;
		--accent-soft: #14B8A6;
		--accent-glow: rgba(15, 118, 110, 0.10);
		--accent-tint: #E6F4F2;
		--text-primary: #10201F;
		--text-secondary: #4B5F5E;
		--text-muted: #5F7372;
		--border: #DCE6E5;
		--border-hover: rgba(15, 118, 110, 0.35);

		--font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
		--font-mono: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
	}

	:global(*) {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	:global(body) {
		background-color: var(--bg-primary);
		color: var(--text-primary);
		font-family: var(--font-sans);
		line-height: 1.6;
		-webkit-font-smoothing: antialiased;
	}

	:global(.header),
	:global(.footer),
	:global(.card) {
		transition: background-color 0.25s ease, border-color 0.25s ease;
	}

	.page {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}

	main {
		flex: 1;
		width: 100%;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 24px;
	}

	:global(h1) {
		font-size: clamp(2.25rem, 5vw, 3.25rem);
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.15;
	}

	:global(h2) {
		font-size: clamp(1.5rem, 3vw, 2rem);
		font-weight: 600;
		letter-spacing: -0.01em;
		line-height: 1.25;
	}

	:global(h3) {
		font-size: 1.2rem;
		font-weight: 600;
		line-height: 1.3;
	}

	:global(p) {
		color: var(--text-secondary);
	}

	:global(a) {
		color: var(--accent);
		text-decoration: none;
		transition: color 0.2s;
	}

	:global(a:hover) {
		color: var(--accent-strong);
	}

	:global(code) {
		background: var(--bg-surface);
		padding: 2px 6px;
		border-radius: 4px;
		font-family: var(--font-mono);
		font-size: 0.9em;
	}

	:global(::selection) {
		background: var(--accent-tint);
		color: var(--text-primary);
	}
</style>

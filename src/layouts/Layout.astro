---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { IDENTITY, CONTACT, SOCIAL } from '../components/SiteConfig';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Portfolio de ingeniería — sistemas reales, decisiones técnicas, resultados." } = Astro.props;

const pageTitle = `${title} | ${IDENTITY.name}`;
const pageDescription = description;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: IDENTITY.fullName,
  jobTitle: "Software Developer",
  email: CONTACT.email,
  sameAs: [CONTACT.github, CONTACT.linkedin],
  url: Astro.url.origin,
};
---

<!doctype html>
<html lang="es" data-theme="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={pageDescription} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>

		<!-- Open Graph -->
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:type" content="website" />
		<meta property="og:image" content={`${Astro.url.origin}${SOCIAL.ogImage}`} />
		<meta property="og:url" content={Astro.url.href} />
		<meta name="twitter:card" content="summary_large_image" />

		<!-- JSON-LD Person -->
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

		<!-- Init theme BEFORE paint — evita flash -->
		<script is:inline>
			(function () {
				const stored = localStorage.getItem('theme');
				const theme = stored || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
				document.documentElement.setAttribute('data-theme', theme);
			})();
		</script>
	</head>
	<body>
		<div class="page">
			<Header />
			<main>
				<slot />
			</main>
			<Footer />
		</div>
	</body>
</html>

<style>
	:global(:root) {
		--bg-primary: #0B1020;
		--bg-surface: #12182B;
		--bg-surface-hover: #1A2140;
		--accent: #8B5CF6;
		--accent-bright: #A855F7;
		--accent-soft: #b6a7f4;
		--accent-glow: rgba(139, 92, 246, 0.15);
		--text-primary: #E8ECF3;
		--text-secondary: #A7B0C2;
		--border: #232B45;
		--border-hover: rgba(139, 92, 246, 0.35);

		/* Personalidad visual por tipo de proyecto */
		--personality: 'clean';
		--card-padding: 20px;
		--card-gap: 16px;
	}

	:global([data-theme="light"]) {
		--bg-primary: #F5F7FB;
		--bg-surface: #FFFFFF;
		--bg-surface-hover: #F0F2F8;
		--accent: #7C3AED;
		--accent-bright: #8B5CF6;
		--accent-soft: #8f64f3;
		--accent-glow: rgba(124, 58, 237, 0.12);
		--text-primary: #111827;
		--text-secondary: #4B5563;
		--border: #D8DDF0;
		--border-hover: rgba(124, 58, 237, 0.25);
	}

	:global([data-theme="light"]) body {
		background-image:
			linear-gradient(rgba(124, 58, 237, 0.03) 1px, transparent 1px),
			linear-gradient(90deg, rgba(124, 58, 237, 0.03) 1px, transparent 1px);
	}

	/* Terminal personality: systems, cli, monitoring */
	:global([data-personality="terminal"]) {
		--personality: 'terminal';
		--card-padding: 16px;
		--card-gap: 12px;
	}

	/* Grid personality: data, time-series */
	:global([data-personality="grid"]) {
		--personality: 'grid';
		--card-padding: 24px;
		--card-gap: 20px;
	}

	/* Fluid personality: web, frontend */
	:global([data-personality="fluid"]) {
		--personality: 'fluid';
		--card-padding: 20px;
		--card-gap: 16px;
	}

	:global(*) {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	:global(body) {
		background-color: var(--bg-primary);
		background-image:
			linear-gradient(rgba(139, 92, 246, 0.025) 1px, transparent 1px),
			linear-gradient(90deg, rgba(139, 92, 246, 0.025) 1px, transparent 1px);
		background-size: 64px 64px;
		background-position: -1px -1px;
		color: var(--text-primary);
		font-family: 'Inter', system-ui, -apple-system, sans-serif;
		line-height: 1.6;
		-webkit-font-smoothing: antialiased;
		transition: background-color 0.35s ease;
	}

	:global(.header),
	:global(.footer),
	:global(.card),
	:global(.area-card),
	:global(.skill-card),
	:global(.pill) {
		transition: background-color 0.25s ease, border-color 0.25s ease;
	}

	.page {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}

	main {
		flex: 1;
		width: 100%;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 24px;
	}

	:global(h1) {
		font-size: clamp(2rem, 5vw, 3.5rem);
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.15;
	}

	:global(h2) {
		font-size: clamp(1.5rem, 3vw, 2rem);
		font-weight: 600;
		letter-spacing: -0.01em;
		line-height: 1.25;
	}

	:global(h3) {
		font-size: 1.25rem;
		font-weight: 600;
		line-height: 1.3;
	}

	:global(p) {
		color: var(--text-secondary);
	}

	:global(a) {
		color: var(--accent-soft);
		text-decoration: none;
		transition: color 0.2s;
	}

	:global(a:hover) {
		color: var(--accent);
	}

	:global(code) {
		background: var(--bg-surface);
		padding: 2px 6px;
		border-radius: 4px;
		font-family: 'JetBrains Mono', 'Fira Code', monospace;
		font-size: 0.9em;
	}

	:global(::selection) {
		background: var(--accent);
		color: white;
	}
</style>

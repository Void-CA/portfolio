---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Portfolio de ingeniería — sistemas reales, decisiones técnicas, resultados." } = Astro.props;
---

<!doctype html>
<html lang="es" data-theme="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Portfolio</title>

		<!-- Init theme BEFORE paint — evita flash -->
		<script is:inline>
			(function () {
				const stored = localStorage.getItem('theme');
				const theme = stored || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
				document.documentElement.setAttribute('data-theme', theme);
			})();
		</script>
	</head>
	<body>
		<div class="page">
			<Header />
			<main>
				<slot />
			</main>
			<Footer />
		</div>
	</body>
</html>

<style>
	:global(:root) {
		--bg-primary: #0F0F14;
		--bg-surface: #1A1A24;
		--bg-surface-hover: #22222E;
		--accent: #7C3AED;
		--accent-soft: #A78BFA;
		--accent-glow: rgba(124, 58, 237, 0.15);
		--text-primary: #E5E7EB;
		--text-secondary: #9CA3AF;
		--border: rgba(255, 255, 255, 0.08);
		--border-hover: rgba(124, 58, 237, 0.3);

		/* Personalidad visual por tipo de proyecto */
		--personality: 'clean';
		--card-padding: 20px;
		--card-gap: 16px;
	}

	:global([data-theme="light"]) {
		--bg-primary: #F9FAFB;
		--bg-surface: #FFFFFF;
		--bg-surface-hover: #F3F4F6;
		--accent: #7C3AED;
		--accent-soft: #6D28D9;
		--accent-glow: rgba(124, 58, 237, 0.12);
		--text-primary: #111827;
		--text-secondary: #6B7280;
		--border: rgba(0, 0, 0, 0.08);
		--border-hover: rgba(124, 58, 237, 0.25);
	}

	/* Terminal personality: systems, cli, monitoring */
	:global([data-personality="terminal"]) {
		--personality: 'terminal';
		--card-padding: 16px;
		--card-gap: 12px;
	}

	/* Grid personality: data, time-series */
	:global([data-personality="grid"]) {
		--personality: 'grid';
		--card-padding: 24px;
		--card-gap: 20px;
	}

	/* Fluid personality: web, frontend */
	:global([data-personality="fluid"]) {
		--personality: 'fluid';
		--card-padding: 20px;
		--card-gap: 16px;
	}

	:global(*) {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	:global(body) {
		background-color: var(--bg-primary);
		color: var(--text-primary);
		font-family: 'Inter', system-ui, -apple-system, sans-serif;
		line-height: 1.6;
		-webkit-font-smoothing: antialiased;
		transition: background-color 0.35s ease, color 0.35s ease;
	}

	:global(.header),
	:global(.footer),
	:global(.card),
	:global(.area-card),
	:global(.skill-card),
	:global(.pill) {
		transition: background-color 0.25s ease, border-color 0.25s ease;
	}

	.page {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}

	main {
		flex: 1;
		width: 100%;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 24px;
	}

	:global(h1) {
		font-size: clamp(2rem, 5vw, 3.5rem);
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.15;
	}

	:global(h2) {
		font-size: clamp(1.5rem, 3vw, 2rem);
		font-weight: 600;
		letter-spacing: -0.01em;
		line-height: 1.25;
	}

	:global(h3) {
		font-size: 1.25rem;
		font-weight: 600;
		line-height: 1.3;
	}

	:global(p) {
		color: var(--text-secondary);
	}

	:global(a) {
		color: var(--accent-soft);
		text-decoration: none;
		transition: color 0.2s;
	}

	:global(a:hover) {
		color: var(--accent);
	}

	:global(code) {
		background: var(--bg-surface);
		padding: 2px 6px;
		border-radius: 4px;
		font-family: 'JetBrains Mono', 'Fira Code', monospace;
		font-size: 0.9em;
	}

	:global(::selection) {
		background: var(--accent);
		color: white;
	}
</style>
